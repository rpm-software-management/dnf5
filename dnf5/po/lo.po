msgstr "ບໍ່ອະນຸຍາດໃຫ້ປ່ຽນແທນແພັກເກດອັດຕະໂນມັດຈາກຜູ້ສະໜອງ (vendor) ຕ່າງກັນ"

#: main.cpp:361
msgid ""
"Don't install files that are marked as documentation (which includes man "
"pages and texinfo documents)"
msgstr "ບໍ່ຕ້ອງຕິດຕັ້ງໄຟລ໌ທີ່ຖືກໝາຍວ່າເປັນເອກະສານອ້າງອີງ (ລວມເຖິງ man pages)"

#: main.cpp:377
msgid "exclude packages by name or glob"
msgstr "ຍົກເວັ້ນແພັກເກດຕາມຊື່ ຫຼື glob"

#: main.cpp:396
msgid ""
"Enable additional repositories. List option. Supports globs, can be "
"specified multiple times."
msgstr "ເປີດໃຊ້ຄັງເກັບເພີ່ມເຕີມ."

#: main.cpp:414
msgid ""
"Disable repositories. List option. Supports globs, can be specified multiple "
"times."
msgstr "ປິດໃຊ້ຄັງເກັບ."

#: main.cpp:432
msgid ""
"Enable just specific repositories. List option. Supports globs, can be "
"specified multiple times."
msgstr "ເປີດໃຊ້ສະເພາະຄັງເກັບທີ່ລະບຸ."

#: main.cpp:454
msgid "disable OpenPGP signature checking (if RPM policy allows)"
msgstr "ປິດການກວດສອບລາຍເຊັນ OpenPGP (ຖ້າ RPM policy ອະນຸຍາດ)"

#: main.cpp:471
msgid "Disable all libdnf5 plugins"
msgstr "ປິດການໃຊ້ງານປລັກອິນ libdnf5 ທັງໝົດ"

#: main.cpp:481
msgid ""
"Enable libdnf5 plugins by name. List option. Supports globs, can be "
"specified multiple times."
msgstr "ເປີດໃຊ້ປລັກອິນ libdnf5 ຕາມຊື່."

#: main.cpp:496
msgid ""
"Disable libdnf5 plugins by name. List option. Supports globs, can be "
"specified multiple times."
msgstr "ປິດໃຊ້ປລັກອິນ libdnf5 ຕາມຊື່."

#: main.cpp:513
msgid "add a comment to transaction"
msgstr "ເພີ່ມຄຳອະທິບາຍ (comment) ໃຫ້ກັບທຸລະກຳ"

#: main.cpp:515
msgid ""
"Adds a comment to the action. If a transaction takes place, the comment is "
"stored in it."
msgstr "ເພີ່ມຄຳອະທິບາຍໃຫ້ກັບການດຳເນີນການ."

#: main.cpp:528
msgid "set install root"
msgstr "ກຳນົດ install root"

#: main.cpp:535
msgid ""
"use configuration, reposdir, and vars from the host system rather than the "
"installroot"
msgstr "ໃຊ້ການຕັ້ງຄ່າ, reposdir, ແລະ ຕົວປ່ຽນຈາກລະບົບໂຮສແທນ installroot"

#: main.cpp:544
msgid "override the value of $releasever in config and repo files"
msgstr "ຂຽນທັບຄ່າ $releasever ໃນໄຟລ໌ຕັ້ງຄ່າ ແລະ ໄຟລ໌ຄັງເກັບ"

#: main.cpp:557
msgid "override the value of $releasever_major in config and repo files"
msgstr "ປ່ຽນຄ່າ $releasever_major ໃນໄຟລ໌ config ແລະ repo"

#: main.cpp:570
msgid "override the value of $releasever_minor in config and repo files"
msgstr "ປ່ຽນຄ່າ $releasever_minor ໃນໄຟລ໌ config ແລະ repo"

#: main.cpp:583
msgid ""
"Show newly installed leaf packages and packages that became leaves after a "
