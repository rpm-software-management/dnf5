msgstr "Mostra solo gli avvisi che fanno riferimento a un bugzilla."

#: commands/advisory/arguments.hpp:107
msgid "Show only advisories referencing a CVE."
msgstr "Mostra solo gli avvisi che fanno riferimento a un CVE."

