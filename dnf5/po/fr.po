msgid "No matches found: no repositories are enabled."
msgstr "Aucune correspondance trouvée : aucun dépôt n'est activé."

#: commands/advisory/advisory_summary.cpp:44
msgid "All"
msgstr "Tous"

#: commands/advisory/advisory_summary.cpp:48
msgid "Installed"
msgstr "Installé"

#: commands/advisory/advisory_summary.cpp:52
msgid "Updates"
msgstr "Mises à jour"

