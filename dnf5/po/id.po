#, c++-format
msgid "No advisory found fixing the Bugzilla ID: \"{}\""
msgstr "Tidak ditemukan advisori untuk memperbaiki Bugzilla ID: \"{}\""

#: commands/advisory_shared.hpp:157
#, c++-format
msgid "No advisory found fixing the CVE ID: \"{}\""
msgstr "Tidak ditemukan advisori perbaikan untuk ID CVE: \"{}\""

#: commands/advisory_shared.hpp:178
msgid "No advisory found matching the specified filters."
msgstr "Tidak ditemukan advisori yang sesuai dengan filter yang ditentukan."

#: commands/advisory_shared.hpp:193
msgid ""
"Include content contained in advisories with specified name. List option."
msgstr ""
"Sertakan konten yang terdapat dalam advisori dengan nama yang ditentukan. "
"Opsi daftar."

#: commands/advisory_shared.hpp:194
msgid "ADVISORY_NAME,..."
msgstr "NAMA_ADVISORI,..."

#: commands/advisory_shared.hpp:201
msgid "Include content contained in security advisories."
msgstr "Sertakan konten yang terdapat dalam advisori keamanan."

#: commands/advisory_shared.hpp:208
msgid "Include content contained in bugfix advisories."
msgstr "Sertakan konten yang terdapat dalam advisori perbaikan bug."

#: commands/advisory_shared.hpp:215
msgid "Include content contained in enhancement advisories."
msgstr "Sertakan konten yang terdapat dalam advisori peningkatan."

#: commands/advisory_shared.hpp:222
msgid "Include content contained in newpackage advisories."
msgstr "Sertakan konten yang terdapat dalam advisori paket baru."

#: commands/advisory_shared.hpp:233
msgid ""
"Include content contained in advisories with specified severity. List "
"option. Can be \"critical\", \"important\", \"moderate\", \"low\", \"none\"."
msgstr ""
"Sertakan konten yang terdapat dalam advisori dengan tingkat keparahan yang "
"ditentukan. Opsi daftar. Dapat berupa \"critical\", \"important\", "
"\"moderate\", \"low\", \"none\"."

#: commands/advisory_shared.hpp:235
msgid "ADVISORY_SEVERITY,..."
msgstr "TINGKAT_KEPARAHAN_ADVISORI,..."

#: commands/advisory_shared.hpp:247
msgid ""
"Include content contained in advisories that fix a Bugzilla ID, Eg. 123123. "
"List option."
msgstr ""
"Sertakan konten yang terdapat dalam advisori yang memperbaiki ID Bugzilla, "
"mis. 123123. Opsi daftar."

#: commands/advisory_shared.hpp:248
msgid "BUGZILLA_ID,..."
msgstr "ID_BUGZILLA,..."

#: commands/advisory_shared.hpp:258
msgid ""
"Include content contained in advisories that fix a CVE (Common "
"Vulnerabilities and Exposures) ID, Eg. CVE-2201-0123. List option."
msgstr ""
"Sertakan konten yang terdapat dalam advisori yang memperbaiki ID CVE (Common "
"Vulnerabilities and Exposures), mis. CVE-2201-0123. Opsi daftar."

#: commands/advisory_shared.hpp:260
msgid "CVE_ID,..."
msgstr "ID_CVE,..."

#: commands/autoremove/autoremove.cpp:38
msgid "Remove all unneeded packages originally installed as dependencies."
msgstr ""
"Hapus semua paket yang tidak diperlukan yang awalnya dipasang sebagai "
"dependensi."

#: commands/autoremove/autoremove.cpp:65
#, c++-format
msgid ""
"Unneeded protected package: {0} (and its dependencies) cannot be removed, "
"either mark it as user-installed or change protected_packages configuration "
"option."
msgstr ""
"Paket terlindungi yang tidak diperlukan: {0} (beserta dependensinya) tidak "
"dapat dihapus. Tandai sebagai diinstal oleh pengguna atau ubah opsi "
"konfigurasi protected_packages."

#: commands/check-upgrade/check-upgrade.cpp:47
msgid "Check for available package upgrades"
msgstr "Periksa peningkatan paket yang tersedia"

#: commands/check-upgrade/check-upgrade.cpp:54
msgid ""
"Reports the lowest versions of packages that fix advisories of type bugfix, "
"enhancement, security, or newpackage. In case that any option limiting "
"advisories is used it reports the lowest versions of packages that fix "
"advisories matching selected advisory properties"
msgstr ""
"Melaporkan versi paket terendah yang memperbaiki advisori dengan tipe "
"perbaikan bug, peningkatan fitur, keamanan, atau paket baru. Jika ada opsi "
"yang membatasi advisori digunakan, maka hanya akan dilaporkan versi paket "
"terendah yang memperbaiki advisori sesuai dengan properti advisori yang "
"dipilih"

#: commands/check/check.cpp:247
msgid "Check for problems in the packagedb"
msgstr "Periksa masalah dalam packagedb"

#: commands/check/check.cpp:335
#, c++-format
msgid "Check discovered {} problem(s) in {} package(s)"
msgstr "Ditemukan masalah {} dalam paket {}"

