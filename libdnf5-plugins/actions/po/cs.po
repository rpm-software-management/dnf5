#: actions.cpp:239
#, c++-format
msgid "File \"{}\" on line {}: {}"
msgstr "Soubor \"{}\" na řádku {}: {}"

#: actions.cpp:627 actions.cpp:633 actions.cpp:639 actions.cpp:645
msgid "\"HOOK:PKG_FILTER:DIRECTION:OPTIONS:CMD\" format expected"
msgstr "Očekáván formát \"HOOK:PKG_FILTER:DIRECTION:OPTIONS:CMD\""

#: actions.cpp:667
#, c++-format
msgid "Unknown \"enabled\" option value \"{}\""
msgstr "Neznámá hodnota volby \"enabled\" \"{}\""

#: actions.cpp:674
#, c++-format
msgid "Unknown option \"{}\""
msgstr "Neznámá možnost \"{}\""

#: actions.cpp:702
#, c++-format
msgid "Unknown hook \"{}\""
msgstr "Neznámý háček \"{}\""

#: actions.cpp:711
msgid ""
"Package filter can only be used in GOAL_RESOLVED, PRE_TRANS and POST_TRANS "
"hooks"
msgstr ""
"Filtr balíčků lze použít pouze v háčcích GOAL_RESOLVED, PRE_TRANS a "
"POST_TRANS"

#: actions.cpp:717
msgid "Cannot use direction without package filter"
msgstr "Nelze použít směr bez filtru balíčku"

#: actions.cpp:731
#, c++-format
msgid "Unknown package direction \"{}\""
msgstr "Neznámý směr balíčku \"{}\""

#: actions.cpp:738
#, c++-format
msgid "Unknown mode \"{}\""
msgstr "Neznámý režim \"{}\""

#: actions.cpp:746
#, c++-format
msgid "Unsupported value of the \"raise_error\" option: {}"
msgstr "Nepodporovaná hodnota možnosti \"raise_error\": {}"

#: actions.cpp:751
msgid "Missing command"
msgstr "Chybí příkaz"

#: actions.cpp:946
#, c++-format
msgid "Syntax error: Missing equal sign (=) in action output line: {}"
msgstr "Chyba syntaxe: Chybějící rovnítko (=) ve výstupním řádku akce: {}"

#: actions.cpp:957
#, c++-format
msgid "Cannot set option: Action output line: {}"
msgstr "Nelze nastavit možnost: Výstupní řádek akce: {}"

#: actions.cpp:975
#, c++-format
msgid "Action sent the wrong log level: {}"
msgstr "Akce odeslala nesprávnou úroveň protokolu: {}"

#: actions.cpp:980 actions.cpp:1792
#, c++-format
msgid "Action calls for stop: {}"
msgstr "Akce volající k zastavení: {}"

#: actions.cpp:983 actions.cpp:1799
#, c++-format
msgid "Action sent error message: {}"
msgstr "Akce odeslala chybovou zprávu: {}"

#: actions.cpp:988
#, c++-format
msgid ""
"Syntax error: Action output line must start with \"tmp.\" or \"conf.\" or "
"\"var.\" or \"stop=\" or \"error=\": {}"
msgstr ""
"Chyba syntaxe: Výstupní řádek akce musí začínat textem \"tmp.\" nebo \"conf."
"\" nebo \"var.\" nebo \"stop=\" nebo \"error=\": {}"

#: actions.cpp:1013
msgid "Error reading from action (from pipe)"
msgstr "Chyba při čtení z akce (z pipe)"

#: actions.cpp:1031
#, c++-format
msgid "Syntax error in json request from action: Missing starting '{{' char"
msgstr "Chyba syntaxe v požadavku JSON z akce: Chybějící počáteční znak '{{'"

#: actions.cpp:1055
msgid "Error during processing of a request from action."
msgstr "Chyba při zpracování požadavku z akce."

#: actions.cpp:1064
#, c++-format
msgid "Syntax error in json request from action: {}"
msgstr "Chyba syntaxe v požadavku JSON z akce: {}"

#: actions.cpp:1072
msgid "Syntax error in json request from action: Incomplete input"
msgstr "Chyba syntaxe v požadavku JSON z akce: Neúplný vstup"

#: actions.cpp:1147
msgid "Cannot write response"
msgstr "Nelze zapsat odpověď"

#: actions.cpp:1819
msgid "Actions plugin: Cannot create pipe"
msgstr "Doplněk akcí: Nelze vytvořit pipe"

#: actions.cpp:1911
msgid "Actions plugin: Cannot fork"
msgstr "Doplněk akcí: Nelze forknout"

#: actions.cpp:1966
msgid "Actions plugin: Cannot bind command stdin"
msgstr "Doplněk akcí: Nelze přiřadit příkaz stdin"

#: actions.cpp:1968
msgid "Actions plugin: Cannot bind command stdout"
msgstr "Doplněk akcí: Nelze přiřadit příkaz stdout"

#: actions.cpp:1986
#, c++-format
msgid "Cannot execute action, command \"{}\" arguments \"{}\""
msgstr "Nelze provést akci, příkaz \"{}\" argumenty \"{}\""

#: actions.cpp:1994
msgid "Error during preparation child process"
msgstr "Chyba během přípravy podřízeného procesu"

#: actions.cpp:2013
#, c++-format
msgid "Exit code: {}"
msgstr "Výstupní kód: {}"

#: actions.cpp:2017
#, c++-format
msgid "Terminated by signal: {}"
msgstr "Ukončeno signálem: {}"

#~ msgid "Error in file \"{}\" on line {}: Unknown option \"{}\""
#~ msgstr "Chyba v souboru \"{}\" na řádku {}: Neznámá volba \"{}\""

