#: automatic.cpp:228
msgid ""
"An alternative CLI to 'dnf upgrade' suitable to be executed automatically "
"and regularly."
msgstr ""
"O alternativă la comanda CLI „dnf upgrade”, potrivită pentru a fi executată "
"automat și periodic."

#: automatic.cpp:234
msgid "Apply random delay before execution."
msgstr "Aplică o întârziere aleatorie înainte de execuție."

#: automatic.cpp:239
msgid "Automatically download updated packages"
msgstr "Descarcă automat pachetele actualizate"

#: automatic.cpp:246
msgid "Do not automatically download updated packages"
msgstr "Nu descarcă automat pachetele actualizate"

#: automatic.cpp:255
msgid "Automatically install downloaded updates"
msgstr "Instalează automat actualizările descărcate"

#: automatic.cpp:262
msgid "Do not automatically install downloaded updates"
msgstr "Nu instalează automat actualizările descărcate"

#: automatic.cpp:322
#, c++-format
msgid ""
"Warning: Configuration file location \"{}\" for dnf automatic is deprecated. "
"See dnf5-automatic(8) for details."
msgstr ""
"Avertisment: Locația fișierului de configurare „{}” pentru dnf automatic "
"este învechită. Consultați dnf5-automatic(8) pentru detalii."

#: automatic.cpp:355
#, c++-format
msgid ""
"The \"email\" emitter is configured but the installed libcurl does not "
"support the {} protocol."
msgstr ""
"Emitentul „email” este configurat, dar biblioteca libcurl instalată nu "
"acceptă protocolul {}."

#: automatic.cpp:398
msgid "Resolved transaction:"
msgstr "Tranzacție rezolvată:"

#: automatic.cpp:427
msgid "Downloading packages:"
msgstr "Se descarcă pachetele:"

#: automatic.cpp:437
msgid "Packages downloaded."
msgstr "Pachete descărcate."

#: automatic.cpp:440
msgid "Running transaction:"
msgstr "Tranzacție în derulare:"

#: automatic.cpp:454
msgid "Transaction finished."
msgstr "Tranzacția s-a încheiat."

#: automatic.cpp:456
msgid "Transaction failed: "
msgstr "Tranzacția a eșuat: "

#: automatic.cpp:489
#, c++-format
msgid "Unknown report emitter for dnf5 automatic: \"{}\"."
msgstr "Emitent necunoscut al raportului pentru dnf5 automatic: „{}”."

#: automatic.cpp:504
#, c++-format
msgid "Error: reboot command returned nonzero exit code: {}"
msgstr ""
"Eroare: comanda „reboot” a returnat un cod de ieșire diferit de zero: {}"

#: emitters.cpp:64
msgid "No new upgrades available."
msgstr "Nu sunt disponibile actualizări noi."

#: emitters.cpp:68
#, c++-format
msgid "{} packages can be upgraded."
msgstr "{} pachete pot fi actualizate."

#: emitters.cpp:71
#, c++-format
msgid "{} new upgrades have been downloaded."
msgstr "Au fost descărcate {} actualizări noi."

#: emitters.cpp:74
#, c++-format
msgid "{} new upgrades have been installed."
msgstr "Au fost instalate {} actualizări noi."

#: emitters.cpp:82
msgid "Failed to check for upgrades."
msgstr "Nu s-a putut verifica dacă există actualizări."

#: emitters.cpp:85
msgid "Failed to download upgrades."
msgstr "Descărcarea actualizărilor a eșuat."

#: emitters.cpp:88
msgid "Failed to install upgrades."
msgstr "Instalarea actualizărilor a eșuat."

#: emitters.cpp:143 emitters.cpp:164
#, c++-format
msgid "[{}] dnf5-automatic: {}"
msgstr "[{}] dnf5-automatic: {}"
