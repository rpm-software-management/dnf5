#: deptree.cpp:31
msgid "Display package dependency trees."
msgstr "პაკეტის დამოკიდებულებების ხის ჩვენება."

#: deptree.cpp:35
msgid "Package names, NEVRAs, or glob patterns."
msgstr "პაკეტის სახელები, NEVRA-ები ან გლობის ნიმუშები."

#: deptree.cpp:45
msgid "Show packages requiring each package."
msgstr "პაკეტების ჩვენება, რომელიც თითოეულ პაკეტს ითხოვს."

#: deptree.cpp:47
msgid "Print a sorted, deduplicated package list."
msgstr "დალაგებული, გამეორებების გარეშე ჩამონათვალის გამოტანა."

#: deptree.cpp:49
msgid "Show requirement capability nodes."
msgstr "მოთხოვნის შესაძლებლობის კვანძების ჩვენება."

#: deptree.cpp:52
msgid "Include all matching package versions."
msgstr "ყველა შესაბამისი პაკეტის ვერსიის ჩათვლა."

#: deptree.cpp:54
msgid "Display dependency trees for installed packages only."
msgstr "დამოკიდებულებების ხეების ჩვენება, მხოლოდ, დაყენებული პაკეტებისთვის."

#: deptree.cpp:59
msgid ""
"Show only branches leading to packages with specified names. List option, "
"supports globs."
msgstr ""
"მხოლოდ იმ ტოტების ჩვენება, რომლებსაც მითითებული სახელის მქონე პაკეტებამდე "
"მივყავართ. სიის პარამეტრი. აქვს გლობების მხარდაჭერა."

#: deptree.cpp:64
msgid "Limit to packages of the specified architectures."
msgstr "შეზღუდვა მითითებული არქიტექტურის პაკეტებზე."

#: deptree.cpp:78
msgid "Limit traversal to N dependency levels."
msgstr "შეზღუდვა დამოკიდებულებების N დონეზე."

#: deptree.cpp:92
msgid ""
"Comma-separated dependency types: requires, recommends, suggests, "
"supplements, enhances."
msgstr ""
"მძიმით გამოყოფილი დამოკიდებულების ტიპები: requires, recommends, suggests, "
"supplements, enhances."

#: deptree.cpp:125
#, c++-format
msgid "No match for argument \"{}\"."
msgstr "არგუმენტს \"{}\" არაფერი ემთხვევა."

#: deptree_graph.cpp:422
#, c++-format
msgid "choice: {}"
msgstr "არჩევანი: {}"

#: deptree_graph.cpp:424
#, c++-format
msgid "if {}:"
msgstr "თუ {}:"

#: deptree_graph.cpp:426
msgid "else:"
msgstr "არადა:"

#: deptree_graph.cpp:428
#, c++-format
msgid "requirement: {}"
msgstr "საჭიროება: {}"

#: deptree_graph.cpp:430
#, c++-format
msgid "unsatisfied: {}"
msgstr "დაუკმაყოფილებელი: {}"

#: deptree_graph.cpp:452
#, c++-format
msgid "{} [expanded elsewhere]"
msgstr "{} [ჩაშლილია სადღაც სხვაგან]"
