#: deptree.cpp:31
msgid "Display package dependency trees."
msgstr "Afișează arborii de dependențe ale pachetelor."

#: deptree.cpp:35
msgid "Package names, NEVRAs, or glob patterns."
msgstr "Nume de pachete, NEVRA-uri sau modele globale."

#: deptree.cpp:45
msgid "Show packages requiring each package."
msgstr "Afișează pachetele ce necesită fiecare pachet."

#: deptree.cpp:47
msgid "Print a sorted, deduplicated package list."
msgstr "Imprimă o listă a pachetelor sortată și fără duplicate."

#: deptree.cpp:49
msgid "Show requirement capability nodes."
msgstr "Afișează nodurile de capacitate necesare."

#: deptree.cpp:52
msgid "Include all matching package versions."
msgstr "Include toate versiunile de pachete compatibile."

#: deptree.cpp:54
msgid "Display dependency trees for installed packages only."
msgstr "Afișează arborii de dependențe numai pentru pachetele instalate."

#: deptree.cpp:59
msgid ""
"Show only branches leading to packages with specified names. List option, "
"supports globs."
msgstr ""
"Afișează numai ramurile care duc la pachete cu numele specificate. Opțiune "
"de listare, acceptă expresii globale."

#: deptree.cpp:64
msgid "Limit to packages of the specified architectures."
msgstr "Limitează la pachetele pentru arhitecturile specificate."

#: deptree.cpp:78
msgid "Limit traversal to N dependency levels."
msgstr "Limitează parcurgerea la N niveluri de dependență."

#: deptree.cpp:92
msgid ""
"Comma-separated dependency types: requires, recommends, suggests, "
"supplements, enhances."
msgstr ""
"Tipuri de dependențe separate prin virgule: necesită, recomandă, sugerează, "
"completează, îmbunătățește."

#: deptree.cpp:125
#, c++-format
msgid "No match for argument \"{}\"."
msgstr "Nu există nicio potrivire pentru argumentul „{}”."

#: deptree_graph.cpp:422
#, c++-format
msgid "choice: {}"
msgstr "alegere: {}"

#: deptree_graph.cpp:424
#, c++-format
msgid "if {}:"
msgstr "dacă {}:"

#: deptree_graph.cpp:426
msgid "else:"
msgstr "altfel:"

#: deptree_graph.cpp:428
#, c++-format
msgid "requirement: {}"
msgstr "cerință: {}"

#: deptree_graph.cpp:430
#, c++-format
msgid "unsatisfied: {}"
msgstr "nesatisfăcut: {}"

#: deptree_graph.cpp:452
#, c++-format
msgid "{} [expanded elsewhere]"
msgstr "{} [detaliat în altă parte]"
