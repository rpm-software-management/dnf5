#: addrepo.cpp:115
#, c++-format
msgid "from-repofile: \"{}\" file does not exist"
msgstr "from-repofile: El fitxer \"{}\" no existeix"

#: addrepo.cpp:118
#, c++-format
msgid "from-repofile: {}"
msgstr "from-repofile: {}"

#: addrepo.cpp:148 setopt.cpp:53 setvar.cpp:49
#, c++-format
msgid "{}: Badly formatted argument value \"{}\""
msgstr "{}: format incorrecte del valor de l'argument \"{}\""

#: addrepo.cpp:158
#, c++-format
msgid "Cannot set repository option \"{}={}\": {}"
msgstr "No es pot establir l'opció de repositori \"{}={}\": {}"

#: addrepo.cpp:166 setopt.cpp:108
#, c++-format
msgid "Sets the \"{}\" option again with a different value: \"{}\" != \"{}\""
msgstr ""
"Estableix un altre cop l'opció {} amb un valor diferent: \"{}\" != \"{}\""

#: addrepo.cpp:232
msgid "Missing path to repository configuration directory"
msgstr "Falta el camí al directori de configuració del dipòsit"

#: addrepo.cpp:282
#, c++-format
msgid "Failed to copy repository configuration file \"{}\": {}"
msgstr "No s'ha pogut copiar el fitxer de configuració del dipòsit {}: {}"

#: addrepo.cpp:293
#, c++-format
msgid "Failed to download repository configuration file \"{}\": {}"
msgstr "No s'ha pogut baixar el fitxer de configuració del dipòsit {}: {}"

#: addrepo.cpp:321
#, c++-format
msgid ""
"Error in added repository configuration file. Cannot set repository option "
"\"{}={}\": {}"
msgstr ""
"Error al fitxer de configuració del dipòsit afegit. No es pot establir "
"l'opció de repositori \"{}={}\": {}"

#: addrepo.cpp:355
#, c++-format
msgid "Bad baseurl: {}={}"
msgstr "Baseurl incorrecte: {}={}"

#: addrepo.cpp:363
msgid ""
"One of --from-repofile=<URL>, --set=baseurl=<URL>, --set=mirrorlist=<URL>, --"
"set=metalink=<URL> must be set to a non-empty URL"
msgstr ""
"Una opció de --from-repofile=<URL>, --set=baseurl=<URL>, --"
"set=mirrorlist=<URL>, --set=metalink=<URL> s'ha d'establir en un URL no buit"

#: addrepo.cpp:408
#, c++-format
msgid "Failed to save repository configuration file \"{}\": {}"
msgstr "No s'ha pogut desar el fitxer de configuració del dipòsit {}: {}"

#: addrepo.cpp:430
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--add-or-replace\" or \"--overwrite\"."
msgstr ""
"El fitxer {} ja existeix i configura els repositoris amb els ID {}. Afegiu-"
"hi \"--add-or-replace\" o \"--overwrite\"."

#: addrepo.cpp:433
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--overwrite\" to overwrite."
msgstr ""
"El fitxer {} ja existeix i configura els repositoris amb els ID {}. Afegiu-"
"hi \"--overwrite\" per sobreescriure'l."

#: addrepo.cpp:453 addrepo.cpp:479
#, c++-format
msgid "A repository with id \"{}\" already configured in file: {}"
msgstr "Un dipòsit amb l'identificador {} ja està configurat al fitxer: {}"

#: addrepo.cpp:465 shared.hpp:156
#, c++-format
msgid "Cannot read repositories from directory \"{}\": {}"
msgstr "No es poden llegir els repositoris del directori {}: {}"

#: addvendorpolicy.cpp:23
msgid "Add a vendor change policy from a TOML file or compact format string"
msgstr ""
"Afegeix una política de canvi de proveïdor des d'un fitxer TOML o una cadena "
"de format compacte"

#: addvendorpolicy.cpp:29
msgid "Policy base filename (without .conf extension)"
msgstr "Nom de fitxer base de la política (sense extensió .conf)"

#: addvendorpolicy.cpp:40
msgid "URL or local path to the source TOML policy file"
msgstr "URL o camí local al fitxer de política TOML d'origen"

#: addvendorpolicy.cpp:52
msgid "Vendor change policy in compact format"
msgstr "Política de canvi de proveïdor en format compacte"

#: addvendorpolicy.cpp:64
msgid "Allow masking a distribution policy"
msgstr "Permet emmascarar una política de distribució"

#: addvendorpolicy.cpp:73
msgid "Allow replacing an existing policy file"
msgstr "Permet reemplaçar un fitxer de política existent"

#: addvendorpolicy.cpp:82
msgid "Require that the new policy masks a distribution policy"
msgstr "Requereix que la nova política emmascari una política de distribució"

#: addvendorpolicy.cpp:94
msgid "Require that the new policy replaces an existing system policy file"
msgstr ""
"Requereix que la nova política substitueixi un fitxer de política del "
"sistema existent"

#: addvendorpolicy.cpp:123
msgid "Option \"{option}\" with nonempty value is required"
msgstr "Es requereix l'opció \"{option}\" amb un valor no buit"

#: addvendorpolicy.cpp:129
msgid "Either \"{option1}\" or non-empty \"{option2}\" is required"
msgstr "Es requereix \"{option1}\" o \"{option2}\" no buida"

#: addvendorpolicy.cpp:142
msgid ""
"Policy file \"{path}\" already exists. Use \"{option}\" to allow replacing "
"it."
msgstr ""
"El fitxer de política \"{path}\" ja existeix. Utilitzeu «{option}» per a "
"permetre la seva substitució."

#: addvendorpolicy.cpp:150
msgid ""
"Distribution policy \"{name}\" already exists. Use \"{option}\" to allow "
"masking it."
msgstr ""
"La política de distribució \"{name}\" ja existeix. Utilitzeu «{option}» per "
"permetre l'emmascarament."

#: addvendorpolicy.cpp:165
msgid ""
"Cannot add policy: option \"{option}\" requires masking a distribution "
"policy, but no distribution policy named \"{name}\" exists."
msgstr ""
"No es pot afegir la política: l'opció \"{option}\" requereix emmascarar una "
"política de distribució, però no existeix cap política de distribució "
"anomenada \"{name}\"."

#: addvendorpolicy.cpp:172
msgid ""
"Cannot add policy: option \"{option}\" requires replacing an existing system "
"policy, but no system policy file named \"{name}\" exists."
msgstr ""
"No es pot afegir la política: l'opció \"{option}\" requereix substituir una "
"política de sistema existent, però no existeix cap fitxer de política de "
"sistema anomenat \"{name}\"."

#: addvendorpolicy.cpp:191 addvendorpolicy.cpp:215 addvendorpolicy.cpp:244
msgid "Replaced vendor policy file: {path}"
msgstr "Fitxer de política de proveïdor reemplaçat: {path}"

#: addvendorpolicy.cpp:196
msgid "Created vendor policy file: {path}"
msgstr "S'ha creat el fitxer de política del proveïdor: {path}"

#: addvendorpolicy.cpp:204
msgid "Source file does not exist: {path}"
msgstr "from-repofile: El fitxer \"{}\" no existeix"

#: addvendorpolicy.cpp:222 addvendorpolicy.cpp:251
msgid "Saved vendor policy file: {path}"
msgstr "Fitxer de política del proveïdor desat: {path}"

#: addvendorpolicy.cpp:260
msgid "Masked distribution policy file: {path}"
msgstr "Fitxer de política de distribució emmascarada: {path}"

#: addvendorpolicy.cpp:264
msgid "Failed to add vendor policy"
msgstr "No s'ha pogut afegir la política del proveïdor"

#: config-manager.cpp:47
msgid "Manage configuration"
msgstr "Gestiona la configuració"

#: listvendorpolicies.cpp:27
msgid "List vendor change policy files"
msgstr "Llista de fitxers de política de canvi del proveïdor"

#: listvendorpolicies.cpp:33 removevendorpolicy.cpp:29
msgid "Policy base filename pattern (supports globs)"
msgstr "Patró de nom de fitxer base de política (suporta globs)"

#: listvendorpolicies.cpp:42
msgid "Show detailed information about the policies"
msgstr "Mostra informació detallada sobre les polítiques"

#: listvendorpolicies.cpp:61 removevendorpolicy.cpp:49
msgid "No vendor policy files found"
msgstr "No s'ha trobat cap fitxer de política de proveïdor"

#: listvendorpolicies.cpp:80 removevendorpolicy.cpp:63
msgid "No matching vendor policy files found for pattern: {pattern}"
msgstr ""
"No s'han trobat fitxers de política de proveïdor coincidents per al patró: "
"{pattern}"

#. Note for translators: This is a right-aligned column separator in
#. a package properties table as in "Name    : bash".
#: listvendorpolicies.cpp:149
msgid " : "
msgstr " : "

#. Add policy info
#: listvendorpolicies.cpp:155
msgid "Policy"
msgstr "Política"

#: listvendorpolicies.cpp:156
msgid "Source"
msgstr "Font"

#: listvendorpolicies.cpp:157
msgid "Distribution (read-only)"
msgstr "Distribució (només lectura)"

#: listvendorpolicies.cpp:157
msgid "System (manageable)"
msgstr "Sistema (gestionable)"

#: listvendorpolicies.cpp:157
msgid "Type"
msgstr "Tipus"

#: listvendorpolicies.cpp:160
msgid "Masks"
msgstr "Màscares"

#: listvendorpolicies.cpp:165
msgid "Masked by"
msgstr "Emmascarat per"

#: listvendorpolicies.cpp:174
msgid "<conversion failed: {what}>"
msgstr "<conversion failed: {what}>"

#: listvendorpolicies.cpp:178 listvendorpolicies.cpp:183
msgid "Compact"
msgstr "Compacta"

#: removevendorpolicy.cpp:23
msgid "Remove vendor change policy files"
msgstr "Elimina els fitxers de política de canvi del proveïdor"

#: removevendorpolicy.cpp:74
msgid "Removed vendor policy file: {path}"
msgstr "S'ha eliminat el fitxer de política del proveïdor: {path}"

#: removevendorpolicy.cpp:78
msgid "Unmasked distribution policy file: {path}"
msgstr "Fitxer de política de distribució desemmascarat: {path}"

#: removevendorpolicy.cpp:83
msgid "Failed to remove policy file: {path}"
msgstr "No s'ha pogut eliminar el fitxer de política: {path}"

#: removevendorpolicy.cpp:87
msgid ""
"Cannot remove distribution policy file \"{path}\". To mask it, use: {command}"
msgstr ""
"No es pot eliminar el fitxer de política de distribució \"{path}\". Per "
"emmascarar-lo, utilitzeu: {command}"

#: repos.cpp:56 setopt.cpp:140
#, c++-format
msgid "No matching repository to modify: {}"
msgstr "No hi ha cap repositori coincident per modificar: {}"

#: repos.hpp:42
msgid "Enables repositories"
msgstr "Habilita els repositoris"

#: repos.hpp:50
msgid "Disables repositories"
msgstr "Desactiva els dipòsits"

#: setopt.cpp:61 unsetopt.cpp:73
#, c++-format
msgid ""
"{}: Badly formatted argument value: Last key character cannot be '.': {}"
msgstr ""
"{}: valor de l'argument incorrecte: l'últim caràcter clau no pot ser '.': {}"

#: setopt.cpp:70 unsetopt.cpp:82
#, c++-format
msgid "{}: Empty repository id is not allowed: {}"
msgstr "{}: un identificador de repositori buit no està permès: {}"

#: setopt.cpp:79
#, c++-format
msgid "Cannot set repository option \"{}\": {}"
msgstr "No es pot establir l'opció de repositori {}: {}"

#: setopt.cpp:86 setopt.cpp:149
#, c++-format
msgid ""
"Sets the \"{}\" option of the repository \"{}\" again with a different "
"value: \"{}\" != \"{}\""
msgstr ""
"Estableix l'opció \"{}\" del repositori {} un altre cop amb un valor "
"diferent: \"{}\" != \"{}\""

#: setopt.cpp:100
#, c++-format
msgid "Cannot set option: \"{}\": {}"
msgstr "No es pot establir l'opció: \"{}\": {}"

#: setvar.cpp:60
#, c++-format
msgid "Cannot set \"{}\": Variable \"{}\" is read-only"
msgstr "No es pot establir {}: la variable \"{}\" és només de lectura"

#: setvar.cpp:68
#, c++-format
msgid "Sets the \"{}\" variable again with a different value: \"{}\" != \"{}\""
msgstr ""
"Estableix un altre cop la variable \"{}\" amb un valor diferent: \"{}\" != \""
"{}\""

#: setvar.cpp:97 unsetvar.cpp:63
msgid "Missing path to vars directory"
msgstr "Falta el camí al directori vars"

#: setvar.cpp:110
#, c++-format
msgid "Cannot write variable to file \"{}\": {}"
msgstr "No es pot escriure la variable al fitxer {}: {}"

#: shared.hpp:65
#, c++-format
msgid ""
"The path \"{}\" exists, but it is not a directory or a symlink to a "
"directory."
msgstr ""
"El camí {} existeix, però no és un directori ni un enllaç simbòlic a un "
"directori."

#: shared.hpp:70
#, c++-format
msgid "The path \"{}\" exists, but it is a symlink to a non-existent object."
msgstr ""
"El camí {} existeix, però és un enllaç simbòlic a un objecte inexistent."

#: shared.hpp:76
#, c++-format
msgid ""
"Directory \"{}\" does not exist. Add \"--create-missing-dir\" to create "
"missing directories."
msgstr ""
"El directori {} no existeix. Afegiu \"--create-missing-dir\" per crear els "
"directoris que falten."

#: shared.hpp:87
#, c++-format
msgid "Variable name can contain only ASCII letters, numbers and '_': {}"
msgstr ""
"El nom de la variable només pot contenir lletres ASCII, números i '_': {}"

#: unsetopt.cpp:94
#, c++-format
msgid "config-manager: Request to remove unsupported repository option: {}"
msgstr ""
"config-manager: sol·licitud per suprimir l'opció de repositori no "
"compatible: {}"

#: unsetopt.cpp:106
#, c++-format
msgid "config-manager: Request to remove unsupported main option: {}"
msgstr ""
"config-manager: sol·licitud per suprimir l'opció principal no compatible: {}"

#: unsetopt.cpp:140
#, c++-format
msgid ""
"config-manager: Request to remove main option but it is not present in the "
"config file: {}"
msgstr ""
"config-manager: sol·licitud per suprimir l'opció principal, però no és "
"present al fitxer de configuració: {}"

#: unsetopt.cpp:152
#, c++-format
msgid ""
"config-manager: Request to remove main option but config file not found: {}"
msgstr ""
"config-manager: sol·licitud per suprimir l'opció principal, però no s'ha "
"trobat el fitxer de configuració: {}"

#: unsetopt.cpp:186
#, c++-format
msgid ""
"config-manager: Request to remove repository option but repoid is not "
"present in the overrides: {}"
msgstr ""
"config-manager: sol·licitud per suprimir l'opció del repositori, però repoid "
"no és present a les sobreescriptures: {}"

#: unsetopt.cpp:194
#, c++-format
msgid ""
"config-manager: Request to remove repository option but it is not present in "
"the overrides: {}.{}"
msgstr ""
"config-manager: sol·licita suprimir l'opció del repositori, però no és "
"present a les sobreescriptures: {}.{}"

#: unsetopt.cpp:208
#, c++-format
msgid ""
"config-manager: Request to remove repository option but file with overrides "
"not found: {}"
msgstr ""
"config-manager: sol·licitud per suprimir l'opció del repositori, però no "
"s'ha trobat el fitxer amb sobreescriptures: {}"

#: unsetvar.cpp:69
#, c++-format
msgid ""
"config-manager: Request to remove variable but vars directory was not found: "
"{}"
msgstr ""
"config-manager: sol·licitud per suprimir la variable però no s'ha trobat el "
"directori vars: {}"

#: unsetvar.cpp:82
#, c++-format
msgid ""
"config-manager: Request to remove variable but it is not present in the vars "
"directory: {}"
msgstr ""
"config-manager: sol·licitud per suprimir la variable però no és present al "
"directori vars: {}"

#: unsetvar.cpp:88
#, c++-format
msgid "Cannot remove variable file \"{}\": {}"
msgstr "No es pot suprimir el fitxer variable {}: {}"
