#: addrepo.cpp:115
#, c++-format
msgid "from-repofile: \"{}\" file does not exist"
msgstr "from-repofile: o arquivo \"{}\" não existe"

#: addrepo.cpp:118
#, c++-format
msgid "from-repofile: {}"
msgstr "from-repofile: {}"

#: addrepo.cpp:148 setopt.cpp:53 setvar.cpp:49
#, c++-format
msgid "{}: Badly formatted argument value \"{}\""
msgstr "{}: Formatação inválida no valor de argumento \"{}\""

#: addrepo.cpp:158
#, c++-format
msgid "Cannot set repository option \"{}={}\": {}"
msgstr "Não foi possível definir a opção de repositório \"{}={}\": {}"

#: addrepo.cpp:166 setopt.cpp:108
#, c++-format
msgid "Sets the \"{}\" option again with a different value: \"{}\" != \"{}\""
msgstr ""
"Define a opção \"{}\" novamente com um valor diferente: \"{}\" != \"{}\""

#: addrepo.cpp:232
msgid "Missing path to repository configuration directory"
msgstr "Faltando caminho para o diretório de configuração de repositório"

#: addrepo.cpp:282
#, c++-format
msgid "Failed to copy repository configuration file \"{}\": {}"
msgstr "Falha ao copiar o arquivo de configuração de repositório \"{}\": {}"

#: addrepo.cpp:293
#, c++-format
msgid "Failed to download repository configuration file \"{}\": {}"
msgstr "Falha ao baixar o arquivo de configuração de repositório \"{}\": {}"

#: addrepo.cpp:321
#, c++-format
msgid ""
"Error in added repository configuration file. Cannot set repository option "
"\"{}={}\": {}"
msgstr ""
"Erro no arquivo de configuração de repositório adicionado. Não é possível "
"definir a opção de repositório \"{}={}\": {}"

#: addrepo.cpp:355
#, c++-format
msgid "Bad baseurl: {}={}"
msgstr "baseurl inválida: {}={}"

#: addrepo.cpp:363
msgid ""
"One of --from-repofile=<URL>, --set=baseurl=<URL>, --set=mirrorlist=<URL>, --"
"set=metalink=<URL> must be set to a non-empty URL"
msgstr ""
"Uma entre --from-repofile=<URL>, --set=baseurl=<URL>, --"
"set=mirrorlist=<URL>, --set=metalink=<URL> deve ser definida com uma URL não "
"vazia"

#: addrepo.cpp:408
#, c++-format
msgid "Failed to save repository configuration file \"{}\": {}"
msgstr "Falha ao salvar o arquivo de configuração de repositório \"{}\": {}"

#: addrepo.cpp:430
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--add-or-replace\" or \"--overwrite\"."
msgstr ""
"O arquivo \"{}\" já existe e configura repositórios com IDs \"{}\". Adicione "
"\"--add-or-replace\" ou \"--overwrite\"."

#: addrepo.cpp:433
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--overwrite\" to overwrite."
msgstr ""
"O arquivo \"{}\" já existe e configura repositórios com IDs \"{}\". Adicione "
"\"--overwrite\" para sobrescrever."

#: addrepo.cpp:453 addrepo.cpp:479
#, c++-format
msgid "A repository with id \"{}\" already configured in file: {}"
msgstr "Um repositório com id \"{}\" já configurado no arquivo: {}"

#: addrepo.cpp:465 shared.hpp:156
#, c++-format
msgid "Cannot read repositories from directory \"{}\": {}"
msgstr "Não é possível ler repositórios do diretório \"{}\": {}"

#: addvendorpolicy.cpp:23
msgid "Add a vendor change policy from a TOML file or compact format string"
msgstr ""
"Adicione uma política de alteração de fornecedor a partir de um arquivo TOML "
"ou de uma string em formato compacto"

#: addvendorpolicy.cpp:29
msgid "Policy base filename (without .conf extension)"
msgstr "Nome base do arquivo de política (sem a extensão .conf)"

#: addvendorpolicy.cpp:40
msgid "URL or local path to the source TOML policy file"
msgstr "URL ou caminho local para o arquivo de política TOML de origem"

#: addvendorpolicy.cpp:52
msgid "Vendor change policy in compact format"
msgstr "Política de alteração de fornecedor em formato compacto"

#: addvendorpolicy.cpp:64
msgid "Allow masking a distribution policy"
msgstr "Permitir a ocultação de uma política de distribuição"

#: addvendorpolicy.cpp:73
msgid "Allow replacing an existing policy file"
msgstr "Permitir a substituição de um arquivo de política existente"

#: addvendorpolicy.cpp:82
msgid "Require that the new policy masks a distribution policy"
msgstr "Exigir que a nova política oculte uma política de distribuição"

#: addvendorpolicy.cpp:94
msgid "Require that the new policy replaces an existing system policy file"
msgstr ""
"Exija que a nova política substitua um arquivo de política de sistema "
"existente"

#: addvendorpolicy.cpp:123
msgid "Option \"{option}\" with nonempty value is required"
msgstr "A opção \"{option}\", com valor não vazio, é obrigatória"

#: addvendorpolicy.cpp:129
msgid "Either \"{option1}\" or non-empty \"{option2}\" is required"
msgstr "É necessário informar \"{option1}\" ou um \"{option2}\" não vazio"

#: addvendorpolicy.cpp:142
msgid ""
"Policy file \"{path}\" already exists. Use \"{option}\" to allow replacing "
"it."
msgstr ""
"O arquivo de política \"{path}\" já existe. Use \"{option}\" para permitir "
"sua substituição."

#: addvendorpolicy.cpp:150
msgid ""
"Distribution policy \"{name}\" already exists. Use \"{option}\" to allow "
"masking it."
msgstr ""
"A política de distribuição \"{name}\" já existe. Use \"{option}\" para "
"permitir a sua substituição."

#: addvendorpolicy.cpp:165
msgid ""
"Cannot add policy: option \"{option}\" requires masking a distribution "
"policy, but no distribution policy named \"{name}\" exists."
msgstr ""
"Não é possível adicionar a política: a opção \"{option}\" exige a ocultação "
"de uma política de distribuição, mas não existe nenhuma política de "
"distribuição chamada \"{name}\"."

#: addvendorpolicy.cpp:172
msgid ""
"Cannot add policy: option \"{option}\" requires replacing an existing system "
"policy, but no system policy file named \"{name}\" exists."
msgstr ""
"Não é possível adicionar a política: a opção \"{option}\" exige a "
"substituição de uma política de sistema existente, mas não existe nenhum "
"arquivo de política de sistema com o nome \"{name}\"."

#: addvendorpolicy.cpp:191 addvendorpolicy.cpp:215 addvendorpolicy.cpp:244
msgid "Replaced vendor policy file: {path}"
msgstr "Arquivo de política do fornecedor substituído: {path}"

#: addvendorpolicy.cpp:196
msgid "Created vendor policy file: {path}"
msgstr "Arquivo de política de fornecedor criado: {path}"

#: addvendorpolicy.cpp:204
msgid "Source file does not exist: {path}"
msgstr "O arquivo de origem não existe: {path}"

#: addvendorpolicy.cpp:222 addvendorpolicy.cpp:251
msgid "Saved vendor policy file: {path}"
msgstr "Arquivo de política do fornecedor salvo: {path}"

#: addvendorpolicy.cpp:260
msgid "Masked distribution policy file: {path}"
msgstr "Arquivo de política de distribuição mascarado: {path}"

#: addvendorpolicy.cpp:264
msgid "Failed to add vendor policy"
msgstr "Falha ao adicionar política de fornecedor"

#: config-manager.cpp:47
msgid "Manage configuration"
msgstr "Gerenciar configuração"

#: listvendorpolicies.cpp:27
msgid "List vendor change policy files"
msgstr "Listar arquivos de política de alteração de fornecedor"

#: listvendorpolicies.cpp:33 removevendorpolicy.cpp:29
msgid "Policy base filename pattern (supports globs)"
msgstr "Padrão de nome de arquivo base da política (suporta globs)"

#: listvendorpolicies.cpp:42
msgid "Show detailed information about the policies"
msgstr "Exibir informações detalhadas sobre as políticas"

#: listvendorpolicies.cpp:61 removevendorpolicy.cpp:49
msgid "No vendor policy files found"
msgstr "Nenhum arquivo de política do fornecedor foi encontrado"

#: listvendorpolicies.cpp:80 removevendorpolicy.cpp:63
msgid "No matching vendor policy files found for pattern: {pattern}"
msgstr ""
"Não foram encontrados arquivos de política de fornecedor correspondentes ao "
"padrão: {pattern}"

#. Note for translators: This is a right-aligned column separator in
#. a package properties table as in "Name    : bash".
#: listvendorpolicies.cpp:149
msgid " : "
msgstr " : "

#. Add policy info
#: listvendorpolicies.cpp:155
msgid "Policy"
msgstr "Política"

#: listvendorpolicies.cpp:156
msgid "Source"
msgstr "Fonte"

#: listvendorpolicies.cpp:157
msgid "Distribution (read-only)"
msgstr "Distribuição (somente leitura)"

#: listvendorpolicies.cpp:157
msgid "System (manageable)"
msgstr "Sistema (gerenciável)"

#: listvendorpolicies.cpp:157
msgid "Type"
msgstr "Tipo"

#: listvendorpolicies.cpp:160
msgid "Masks"
msgstr "Máscaras"

#: listvendorpolicies.cpp:165
msgid "Masked by"
msgstr "Mascarado por"

#: listvendorpolicies.cpp:174
msgid "<conversion failed: {what}>"
msgstr "<conversão falhou: {what}>"

#: listvendorpolicies.cpp:178 listvendorpolicies.cpp:183
msgid "Compact"
msgstr "Compactar"

#: removevendorpolicy.cpp:23
msgid "Remove vendor change policy files"
msgstr "Remover arquivos de política de alterações do fornecedor"

#: removevendorpolicy.cpp:74
msgid "Removed vendor policy file: {path}"
msgstr "Arquivo de política do fornecedor removido: {path}"

#: removevendorpolicy.cpp:78
msgid "Unmasked distribution policy file: {path}"
msgstr "Arquivo de política de distribuição não mascarado: {path}"

#: removevendorpolicy.cpp:83
msgid "Failed to remove policy file: {path}"
msgstr "Falha ao remover o arquivo de política: {path}"

#: removevendorpolicy.cpp:87
msgid ""
"Cannot remove distribution policy file \"{path}\". To mask it, use: {command}"
msgstr ""
"Não é possível remover o arquivo de política de distribuição \"{path}\". "
"Para ocultá-lo, utilize: {command}"

#: repos.cpp:56 setopt.cpp:140
#, c++-format
msgid "No matching repository to modify: {}"
msgstr "Nenhum repositório correspondente para modificar: {}"

#: repos.hpp:42
msgid "Enables repositories"
msgstr "Habilita repositórios"

#: repos.hpp:50
msgid "Disables repositories"
msgstr "Desabilita repositórios"

#: setopt.cpp:61 unsetopt.cpp:73
#, c++-format
msgid ""
"{}: Badly formatted argument value: Last key character cannot be '.': {}"
msgstr ""
"{}: Formatação inválida no valor de argumento: O último caractere da chave "
"não pode ser '.': {}"

#: setopt.cpp:70 unsetopt.cpp:82
#, c++-format
msgid "{}: Empty repository id is not allowed: {}"
msgstr "{}: ID de repositório vazio não é permitido: {}"

#: setopt.cpp:79
#, c++-format
msgid "Cannot set repository option \"{}\": {}"
msgstr "Não é possível definir a opção de repositório \"{}\": {}"

#: setopt.cpp:86 setopt.cpp:149
#, c++-format
msgid ""
"Sets the \"{}\" option of the repository \"{}\" again with a different "
"value: \"{}\" != \"{}\""
msgstr ""
"Define a opção \"{}\" do repositório \"{}\" novamente com um valor "
"diferente: \"{}\" != \"{}\""

#: setopt.cpp:100
#, c++-format
msgid "Cannot set option: \"{}\": {}"
msgstr "Não é possível definir a opção: \"{}\": {}"

#: setvar.cpp:60
#, c++-format
msgid "Cannot set \"{}\": Variable \"{}\" is read-only"
msgstr "Não é possível definir \"{}\": A variável \"{}\" é somente leitura"

#: setvar.cpp:68
#, c++-format
msgid "Sets the \"{}\" variable again with a different value: \"{}\" != \"{}\""
msgstr ""
"Define a variável \"{}\" novamente com um valor diferente: \"{}\" != \"{}\""

#: setvar.cpp:97 unsetvar.cpp:63
msgid "Missing path to vars directory"
msgstr "Faltando caminho para o diretório de variáveis"

#: setvar.cpp:110
#, c++-format
msgid "Cannot write variable to file \"{}\": {}"
msgstr "Não é possível escrever a variável para o arquivo \"{}\": {}"

#: shared.hpp:65
#, c++-format
msgid ""
"The path \"{}\" exists, but it is not a directory or a symlink to a "
"directory."
msgstr ""
"O caminho \"{}\" existe, mas ele não é um diretório ou um link simbólico "
"para um diretório."

#: shared.hpp:70
#, c++-format
msgid "The path \"{}\" exists, but it is a symlink to a non-existent object."
msgstr ""
"O caminho \"{}\" existe, mas ele é um link simbólico para um objeto "
"inexistente."

#: shared.hpp:76
#, c++-format
msgid ""
"Directory \"{}\" does not exist. Add \"--create-missing-dir\" to create "
"missing directories."
msgstr ""
"O diretório \"{}\" não existe. Adicione \"--create-missing-dir\" para criar "
"diretórios em falta."

#: shared.hpp:87
#, c++-format
msgid "Variable name can contain only ASCII letters, numbers and '_': {}"
msgstr "Nome de variável pode conter apenas letras ASCII, números e '_': {}"

#: unsetopt.cpp:94
#, c++-format
msgid "config-manager: Request to remove unsupported repository option: {}"
msgstr ""
"config-manager: Solicitação para remover opção de repositório não "
"compatível: {}"

#: unsetopt.cpp:106
#, c++-format
msgid "config-manager: Request to remove unsupported main option: {}"
msgstr ""
"config-manager: Solicitação para remover opção principal não compatível: {}"

#: unsetopt.cpp:140
#, c++-format
msgid ""
"config-manager: Request to remove main option but it is not present in the "
"config file: {}"
msgstr ""
"config-manager: Solicitação para remover a opção principal, mas não está "
"presente no arquivo de configuração: {}"

#: unsetopt.cpp:152
#, c++-format
msgid ""
"config-manager: Request to remove main option but config file not found: {}"
msgstr ""
"config-manager: Solicitação para remover a opção principal, mas o arquivo de "
"configuração não foi encontrado: {}"

#: unsetopt.cpp:186
#, c++-format
msgid ""
"config-manager: Request to remove repository option but repoid is not "
"present in the overrides: {}"
msgstr ""
"config-manager: Solicitação de remover a opção de repositório, mas repoid "
"não está presente na sobrescrição: {}"

#: unsetopt.cpp:194
#, c++-format
msgid ""
"config-manager: Request to remove repository option but it is not present in "
"the overrides: {}.{}"
msgstr ""
"config-manager: Solicitação para remover a opção de repositório, mas não "
"está presente nas sobrescrições: {}.{}"

#: unsetopt.cpp:208
#, c++-format
msgid ""
"config-manager: Request to remove repository option but file with overrides "
"not found: {}"
msgstr ""
"config-manager: Solicitação para remover a opção de repositório, mas o "
"arquivo com sobrescrições não foi encontrado: {}"

#: unsetvar.cpp:69
#, c++-format
msgid ""
"config-manager: Request to remove variable but vars directory was not found: "
"{}"
msgstr ""
"config-manager: Solicitação para remover variável, mas diretório de "
"variáveis não foi encontrado: {}"

#: unsetvar.cpp:82
#, c++-format
msgid ""
"config-manager: Request to remove variable but it is not present in the vars "
"directory: {}"
msgstr ""
"config-manager: Solicitação para remover variável, mas ela não está presente "
"no diretório de variáveis: {}"

#: unsetvar.cpp:88
#, c++-format
msgid "Cannot remove variable file \"{}\": {}"
msgstr "Não é possível remover o arquivo de variável \"{}\": {}"

