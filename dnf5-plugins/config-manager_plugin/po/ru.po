#: addrepo.cpp:115
#, c++-format
msgid "from-repofile: \"{}\" file does not exist"
msgstr "from-repofile: \"{}\" файл не существует"

#: addrepo.cpp:118
#, c++-format
msgid "from-repofile: {}"
msgstr "from-repofile: {}"

#: addrepo.cpp:148 setopt.cpp:53 setvar.cpp:49
#, c++-format
msgid "{}: Badly formatted argument value \"{}\""
msgstr "{}: Плохо отформатированное значение аргумента \"{}\""

#: addrepo.cpp:158
#, c++-format
msgid "Cannot set repository option \"{}={}\": {}"
msgstr "Невозможно установить опцию репозитория \"{}={}\": {}"

#: addrepo.cpp:166 setopt.cpp:108
#, c++-format
msgid "Sets the \"{}\" option again with a different value: \"{}\" != \"{}\""
msgstr "Устанавливает опцию \"{}\" снова, с другим значением: \"{}\" != \"{}\""

#: addrepo.cpp:232
msgid "Missing path to repository configuration directory"
msgstr "Отсутствует путь к каталогу конфигурации репозитория"

#: addrepo.cpp:282
#, c++-format
msgid "Failed to copy repository configuration file \"{}\": {}"
msgstr "Не удалось скопировать файл конфигурации репозитория \"{}\": {}"

#: addrepo.cpp:293
#, c++-format
msgid "Failed to download repository configuration file \"{}\": {}"
msgstr "Не удалось загрузить файл конфигурации репозитория \"{}\": {}"

#: addrepo.cpp:321
#, c++-format
msgid ""
"Error in added repository configuration file. Cannot set repository option "
"\"{}={}\": {}"
msgstr ""
"Ошибка в добавленном файле конфигурации репозитория. Невозможно установить "
"опцию репозитория \"{}={}\": {}"

#: addrepo.cpp:355
#, c++-format
msgid "Bad baseurl: {}={}"
msgstr "Плохой baseurl: {}={}"

#: addrepo.cpp:363
msgid ""
"One of --from-repofile=<URL>, --set=baseurl=<URL>, --set=mirrorlist=<URL>, --"
"set=metalink=<URL> must be set to a non-empty URL"
msgstr ""
"Одно из значений --from-repofile=<URL>, --set=baseurl=<URL>, --"
"set=mirrorlist=<URL>, --set=metalink=<URL> должно быть установлено на "
"непустой URL"

#: addrepo.cpp:408
#, c++-format
msgid "Failed to save repository configuration file \"{}\": {}"
msgstr "Не удалось сохранить файл конфигурации репозитория \"{}\": {}"

#: addrepo.cpp:430
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--add-or-replace\" or \"--overwrite\"."
msgstr ""
"Файл \"{}\" уже существует и настраивает репозитории с идентификаторами \"{}"
"\". Добавьте \"--add-or-replace\" или \"--overwrite\"."

#: addrepo.cpp:433
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--overwrite\" to overwrite."
msgstr ""
"Файл \"{}\" уже существует и настраивает репозитории с идентификаторами \"{}"
"\". Добавьте \"--overwrite\" для перезаписи."

#: addrepo.cpp:453 addrepo.cpp:479
#, c++-format
msgid "A repository with id \"{}\" already configured in file: {}"
msgstr "Репозиторий с идентификатором \"{}\" уже настроен в файле: {}"

#: addrepo.cpp:465 shared.hpp:156
#, c++-format
msgid "Cannot read repositories from directory \"{}\": {}"
msgstr "Невозможно прочитать репозитории из каталога \"{}\": {}"

#: addvendorpolicy.cpp:23
msgid "Add a vendor change policy from a TOML file or compact format string"
msgstr ""
"Добавить политику смены вендора из файла TOML или строки в компактном формате"

#: addvendorpolicy.cpp:29
msgid "Policy base filename (without .conf extension)"
msgstr "Базовое имя файла политики (без расширения .conf)"

#: addvendorpolicy.cpp:40
msgid "URL or local path to the source TOML policy file"
msgstr "URL или локальный путь к исходному файлу политики TOML"

#: addvendorpolicy.cpp:52
msgid "Vendor change policy in compact format"
msgstr "Политика смены вендора в компактном формате"

#: addvendorpolicy.cpp:64
msgid "Allow masking a distribution policy"
msgstr "Разрешить маскировку политики дистрибутива"

#: addvendorpolicy.cpp:73
msgid "Allow replacing an existing policy file"
msgstr "Разрешить замену существующего файла политики"

#: addvendorpolicy.cpp:82
msgid "Require that the new policy masks a distribution policy"
msgstr "Требовать, чтобы новая политика маскировала политику дистрибутива"

#: addvendorpolicy.cpp:94
msgid "Require that the new policy replaces an existing system policy file"
msgstr ""
"Требовать, чтобы новая политика заменяла существующий системный файл политики"

#: addvendorpolicy.cpp:123
msgid "Option \"{option}\" with nonempty value is required"
msgstr "Требуется параметр «{option}» с непустым значением"

#: addvendorpolicy.cpp:129
msgid "Either \"{option1}\" or non-empty \"{option2}\" is required"
msgstr "Требуется либо «{option1}», либо непустой «{option2}»"

#: addvendorpolicy.cpp:142
msgid ""
"Policy file \"{path}\" already exists. Use \"{option}\" to allow replacing "
"it."
msgstr ""
"Файл политики «{path}» уже существует. Используйте «{option}», чтобы "
"разрешить его замену."

#: addvendorpolicy.cpp:150
msgid ""
"Distribution policy \"{name}\" already exists. Use \"{option}\" to allow "
"masking it."
msgstr ""
"Политика дистрибутива «{name}» уже существует. Используйте «{option}», чтобы "
"разрешить её маскировку."

#: addvendorpolicy.cpp:165
msgid ""
"Cannot add policy: option \"{option}\" requires masking a distribution "
"policy, but no distribution policy named \"{name}\" exists."
msgstr ""
"Не удалось добавить политику: параметр «{option}» требует маскировки "
"политики дистрибутива, но политика дистрибутива с именем «{name}» не "
"существует."

#: addvendorpolicy.cpp:172
msgid ""
"Cannot add policy: option \"{option}\" requires replacing an existing system "
"policy, but no system policy file named \"{name}\" exists."
msgstr ""
"Не удалось добавить политику: параметр «{option}» требует замены "
"существующей системной политики, но системный файл политики с именем «{name}"
"» не существует."

#: addvendorpolicy.cpp:191 addvendorpolicy.cpp:215 addvendorpolicy.cpp:244
msgid "Replaced vendor policy file: {path}"
msgstr "Заменён файл политики вендора: {path}"

#: addvendorpolicy.cpp:196
msgid "Created vendor policy file: {path}"
msgstr "Создан файл политики вендора: {path}"

#: addvendorpolicy.cpp:204
msgid "Source file does not exist: {path}"
msgstr "Исходный файл не существует: {path}"

#: addvendorpolicy.cpp:222 addvendorpolicy.cpp:251
msgid "Saved vendor policy file: {path}"
msgstr "Сохранён файл политики вендора: {path}"

#: addvendorpolicy.cpp:260
msgid "Masked distribution policy file: {path}"
msgstr "Замаскирован файл политики дистрибутива: {path}"

#: addvendorpolicy.cpp:264
msgid "Failed to add vendor policy"
msgstr "Не удалось добавить политику вендора"

#: config-manager.cpp:47
msgid "Manage configuration"
msgstr "Управление конфигурацией"

#: listvendorpolicies.cpp:27
msgid "List vendor change policy files"
msgstr "Показать файлы политики смены вендора"

#: listvendorpolicies.cpp:33 removevendorpolicy.cpp:29
msgid "Policy base filename pattern (supports globs)"
msgstr ""
"Шаблон базового имени файла политики (поддерживает подстановочные знаки)"

#: listvendorpolicies.cpp:42
msgid "Show detailed information about the policies"
msgstr "Показать подробную информацию о политиках"

#: listvendorpolicies.cpp:61 removevendorpolicy.cpp:49
msgid "No vendor policy files found"
msgstr "Файлы политики вендора не найдены"

#: listvendorpolicies.cpp:80 removevendorpolicy.cpp:63
msgid "No matching vendor policy files found for pattern: {pattern}"
msgstr "Не найдено файлов политики вендора, соответствующих шаблону: {pattern}"

#. Note for translators: This is a right-aligned column separator in
#. a package properties table as in "Name    : bash".
#: listvendorpolicies.cpp:149
msgid " : "
msgstr " : "

#. Add policy info
#: listvendorpolicies.cpp:155
msgid "Policy"
msgstr "Политика"

#: listvendorpolicies.cpp:156
msgid "Source"
msgstr "Источник"

#: listvendorpolicies.cpp:157
msgid "Distribution (read-only)"
msgstr "Дистрибутив (только для чтения)"

#: listvendorpolicies.cpp:157
msgid "System (manageable)"
msgstr "Система (управляемая)"

#: listvendorpolicies.cpp:157
msgid "Type"
msgstr "Тип"

#: listvendorpolicies.cpp:160
msgid "Masks"
msgstr "Маскирует"

#: listvendorpolicies.cpp:165
msgid "Masked by"
msgstr "Замаскировано"

#: listvendorpolicies.cpp:174
msgid "<conversion failed: {what}>"
msgstr "<ошибка преобразования: {what}>"

#: listvendorpolicies.cpp:178 listvendorpolicies.cpp:183
msgid "Compact"
msgstr "Компактный"

#: removevendorpolicy.cpp:23
msgid "Remove vendor change policy files"
msgstr "Удалить файлы политики смены вендора"

#: removevendorpolicy.cpp:74
msgid "Removed vendor policy file: {path}"
msgstr "Удалён файл политики вендора: {path}"

#: removevendorpolicy.cpp:78
msgid "Unmasked distribution policy file: {path}"
msgstr "Снята маскировка с файла политики дистрибутива: {path}"

#: removevendorpolicy.cpp:83
msgid "Failed to remove policy file: {path}"
msgstr "Не удалось удалить файл политики: {path}"

#: removevendorpolicy.cpp:87
msgid ""
"Cannot remove distribution policy file \"{path}\". To mask it, use: {command}"
msgstr ""
"Не удалось удалить файл политики дистрибутива «{path}». Чтобы замаскировать "
"его, используйте: {command}"

#: repos.cpp:56 setopt.cpp:140
#, c++-format
msgid "No matching repository to modify: {}"
msgstr "Нет подходящего репозитория для изменения: {}"

#: repos.hpp:42
msgid "Enables repositories"
msgstr "Включает репозитории"

#: repos.hpp:50
msgid "Disables repositories"
msgstr "Отключает репозитории"

#: setopt.cpp:61 unsetopt.cpp:73
#, c++-format
msgid ""
"{}: Badly formatted argument value: Last key character cannot be '.': {}"
msgstr ""
"{}: Плохо отформатированное значение аргумента: Последний символ ключа не "
"может быть '.': {}"

#: setopt.cpp:70 unsetopt.cpp:82
#, c++-format
msgid "{}: Empty repository id is not allowed: {}"
msgstr "{}: Пустой идентификатор репозитория недопустим: {}"

#: setopt.cpp:79
#, c++-format
msgid "Cannot set repository option \"{}\": {}"
msgstr "Невозможно установить параметр репозитория \"{}\": {}"

#: setopt.cpp:86 setopt.cpp:149
#, c++-format
msgid ""
"Sets the \"{}\" option of the repository \"{}\" again with a different "
"value: \"{}\" != \"{}\""
msgstr ""
"Устанавливает опцию \"{}\" репозитория \"{}\" снова, с другим значением: \"{}"
"\" != \"{}\""

#: setopt.cpp:100
#, c++-format
msgid "Cannot set option: \"{}\": {}"
msgstr "Невозможно установить опцию: \"{}\": {}"

#: setvar.cpp:60
#, c++-format
msgid "Cannot set \"{}\": Variable \"{}\" is read-only"
msgstr ""
"Невозможно установить \"{}\": Переменная \"{}\" доступна только для чтения"

#: setvar.cpp:68
#, c++-format
msgid "Sets the \"{}\" variable again with a different value: \"{}\" != \"{}\""
msgstr ""
"Устанавливает переменную \"{}\" снова, с другим значением: \"{}\" != \"{}\""

#: setvar.cpp:97 unsetvar.cpp:63
msgid "Missing path to vars directory"
msgstr "Отсутствует путь к каталогу vars"

#: setvar.cpp:110
#, c++-format
msgid "Cannot write variable to file \"{}\": {}"
msgstr "Невозможно записать переменную в файл \"{}\": {}"

#: shared.hpp:65
#, c++-format
msgid ""
"The path \"{}\" exists, but it is not a directory or a symlink to a "
"directory."
msgstr ""
"Путь \"{}\" существует, но он не является каталогом или симлинком на каталог."

#: shared.hpp:70
#, c++-format
msgid "The path \"{}\" exists, but it is a symlink to a non-existent object."
msgstr "Путь \"{}\" существует, но это симлинк на несуществующий объект."

#: shared.hpp:76
#, c++-format
msgid ""
"Directory \"{}\" does not exist. Add \"--create-missing-dir\" to create "
"missing directories."
msgstr ""
"Каталог \"{}\" не существует. Добавьте \"--create-missing-dir\" для создания "
"отсутствующих каталогов."

#: shared.hpp:87
#, c++-format
msgid "Variable name can contain only ASCII letters, numbers and '_': {}"
msgstr "Имя переменной может содержать только буквы ASCII, цифры и '_': {}"

#: unsetopt.cpp:94
#, c++-format
msgid "config-manager: Request to remove unsupported repository option: {}"
msgstr ""
"config-manager: Запрос на удаление неподдерживаемой опции репозитория: {}"

#: unsetopt.cpp:106
#, c++-format
msgid "config-manager: Request to remove unsupported main option: {}"
msgstr "config-manager: Запрос на удаление неподдерживаемой основной опции: {}"

#: unsetopt.cpp:140
#, c++-format
msgid ""
"config-manager: Request to remove main option but it is not present in the "
"config file: {}"
msgstr ""
"config-manager: Запрос на удаление главной опции, но она отсутствует в файле "
"конфигурации: {}"

#: unsetopt.cpp:152
#, c++-format
msgid ""
"config-manager: Request to remove main option but config file not found: {}"
msgstr ""
"config-manager: Запрос на удаление главной опции, но файл конфигурации не "
"найден: {}"

#: unsetopt.cpp:186
#, c++-format
msgid ""
"config-manager: Request to remove repository option but repoid is not "
"present in the overrides: {}"
msgstr ""
"config-manager: Запрос на удаление опции репозитория, но репоид отсутствует "
"в переопределениях: {}"

#: unsetopt.cpp:194
#, c++-format
msgid ""
"config-manager: Request to remove repository option but it is not present in "
"the overrides: {}.{}"
msgstr ""
"config-manager: Запрос на удаление опции репозитория, но она отсутствует в "
"переопределениях: {}.{}"

#: unsetopt.cpp:208
#, c++-format
msgid ""
"config-manager: Request to remove repository option but file with overrides "
"not found: {}"
msgstr ""
"config-manager: Запрос на удаление опции репозитория, но файл с "
"переопределениями не найден: {}"

#: unsetvar.cpp:69
#, c++-format
msgid ""
"config-manager: Request to remove variable but vars directory was not found: "
"{}"
msgstr ""
"config-manager: Запрос на удаление переменной, но каталог vars не найден: {}"

#: unsetvar.cpp:82
#, c++-format
msgid ""
"config-manager: Request to remove variable but it is not present in the vars "
"directory: {}"
msgstr ""
"config-manager: Запрос на удаление переменной, но она отсутствует в каталоге "
"vars: {}"

#: unsetvar.cpp:88
#, c++-format
msgid "Cannot remove variable file \"{}\": {}"
msgstr "Невозможно удалить файл переменных \"{}\": {}"
