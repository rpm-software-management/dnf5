#: addrepo.cpp:115
#, c++-format
msgid "from-repofile: \"{}\" file does not exist"
msgstr "რეპოფაილიდან: ფაილი \"{}\" არ არსებობს"

#: addrepo.cpp:118
#, c++-format
msgid "from-repofile: {}"
msgstr "რეპოფაილიდან: {}"

#: addrepo.cpp:148 setopt.cpp:53 setvar.cpp:49
#, c++-format
msgid "{}: Badly formatted argument value \"{}\""
msgstr "{}: ცუდად დაფორმატებული არგუმენტის მნიშვნელობა \"{}\""

#: addrepo.cpp:158
#, c++-format
msgid "Cannot set repository option \"{}={}\": {}"
msgstr "ვერ დავაყენე რეპოზიტორიის პარამეტრი \"{}={}\": {}"

#: addrepo.cpp:166 setopt.cpp:108
#, c++-format
msgid "Sets the \"{}\" option again with a different value: \"{}\" != \"{}\""
msgstr ""
"დააყენებს პარამეტრს \"{}\" კიდევ ერთხელ სხვა მნიშვნელობით: \"{}\" != \"{}\""

#: addrepo.cpp:232
msgid "Missing path to repository configuration directory"
msgstr "აკლია რეპოზიტორიის კონფიგურაციის საქაღალდის ბილიკი"

#: addrepo.cpp:282
#, c++-format
msgid "Failed to copy repository configuration file \"{}\": {}"
msgstr "რეპოზიტორიის კონფიგურაციის ფაილის \"{}\" კოპირება ჩავარდა: {}"

#: addrepo.cpp:293
#, c++-format
msgid "Failed to download repository configuration file \"{}\": {}"
msgstr "რეპოზიტორიის კონფიგურაციის ფაილის \"{}\" გადმოწერა ჩავარდა: {}"

#: addrepo.cpp:321
#, c++-format
msgid ""
"Error in added repository configuration file. Cannot set repository option "
"\"{}={}\": {}"
msgstr ""
"შეცდომა დამატებული რეპოზიტორიის კონფიგურაციის ფაილში. ვერ დავაყენე "
"რეპოზიტორიის პარამეტრი \"{}={}\": {}"

#: addrepo.cpp:355
#, c++-format
msgid "Bad baseurl: {}={}"
msgstr "არასწორი baseurl: {}={}"

#: addrepo.cpp:363
msgid ""
"One of --from-repofile=<URL>, --set=baseurl=<URL>, --set=mirrorlist=<URL>, --"
"set=metalink=<URL> must be set to a non-empty URL"
msgstr ""
"ერთ-ერთი პარამეტრებიდან --from-repofile=<URL>, --set=baseurl=<URL>, --"
"set=mirrorlist=<URL>, --set=metalink=<URL> არაცარიელ URL-ზე უნდა ეყენოს"

#: addrepo.cpp:408
#, c++-format
msgid "Failed to save repository configuration file \"{}\": {}"
msgstr "რეპოზიტორიის კონფიგურაციის ფაილის \"{}\" შენახვა ჩავარდა: {}"

#: addrepo.cpp:430
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--add-or-replace\" or \"--overwrite\"."
msgstr ""
"ფაილი \"{}\" უკვე არსებობს და მიუთითებს რეპოზიტორიებზე ID-ებით \"{}\". "
"დაამატეთ \"--add-or-replace\" ან \"--overwrite\"."

#: addrepo.cpp:433
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--overwrite\" to overwrite."
msgstr ""
"ფაილი \"{}\" უკვე არსებობს და მიუთითებს რეპოზიტორიებზე ID-ებით \"{}\". თავზე "
"გადასაწერად დაამატეთ \"--overwrite\"."

#: addrepo.cpp:453 addrepo.cpp:479
#, c++-format
msgid "A repository with id \"{}\" already configured in file: {}"
msgstr "რეპოზიტორია id-ით \"{}\" უკვე მორგებულია ფაილში:{}"

#: addrepo.cpp:465 shared.hpp:156
#, c++-format
msgid "Cannot read repositories from directory \"{}\": {}"
msgstr "ვერ წავიკითხე რეპოზიტორია საქაღალდიდან \"{}\": {}"

#: addvendorpolicy.cpp:23
msgid "Add a vendor change policy from a TOML file or compact format string"
msgstr ""
"მომწოდებლის შეცვლის პოლიტიკის დამატება TOML ფაილიდან, ან კომპაქტური ფორმატის "
"სტრიქონიდან"

#: addvendorpolicy.cpp:29
msgid "Policy base filename (without .conf extension)"
msgstr "პოლიტიკის საბაზისო ფაილის სახელი (.conf გაფართოების გარეშე)"

#: addvendorpolicy.cpp:40
msgid "URL or local path to the source TOML policy file"
msgstr "URL, ან ლოკალური ბილიკი წყარო TOML პოლიტიკის ფაილამდე"

#: addvendorpolicy.cpp:52
msgid "Vendor change policy in compact format"
msgstr "მომწოდებლის ცვლილების პოლიტიკა კომპაქტურ ფორმატში"

#: addvendorpolicy.cpp:64
msgid "Allow masking a distribution policy"
msgstr "განაწილების პოლიტიკის შენიღბვის დაშვება"

#: addvendorpolicy.cpp:73
msgid "Allow replacing an existing policy file"
msgstr "არსებული პოლიტიკის ფაილის ჩანაცვლების დაშვება"

#: addvendorpolicy.cpp:82
msgid "Require that the new policy masks a distribution policy"
msgstr "მოთხოვნა, რომ ახალი პოლიტიკა განაწილების პოლიტიკას ნიღბავდეს"

#: addvendorpolicy.cpp:94
msgid "Require that the new policy replaces an existing system policy file"
msgstr ""
"მოთხოვნა, რომ ახალი პოლიტიკა არსებულ სისტემური პოლიტიკის ფაილს ანაცვლებდეს"

#: addvendorpolicy.cpp:123
msgid "Option \"{option}\" with nonempty value is required"
msgstr "აუცილებელია პარამეტრი \"{option}\" არაცარიელი მნიშვნელობით"

#: addvendorpolicy.cpp:129
msgid "Either \"{option1}\" or non-empty \"{option2}\" is required"
msgstr "აუცილებელია \" \"{option1}\", ან არაცარიელი \"{option2}\""

#: addvendorpolicy.cpp:142
msgid ""
"Policy file \"{path}\" already exists. Use \"{option}\" to allow replacing "
"it."
msgstr ""
"პოლიტიკის ფაილი \"{path}\" უკვე არსებობს. მისი ჩანაცვლების დასაშვებად "
"გამოიყენეთ \"{option}\"."

#: addvendorpolicy.cpp:150
msgid ""
"Distribution policy \"{name}\" already exists. Use \"{option}\" to allow "
"masking it."
msgstr ""
"განაწილების პოლიტიკა \"{name}\" უკვე არსებობს. მის შესანიღბად გამოიყენეთ \""
"{option}\"."

#: addvendorpolicy.cpp:165
msgid ""
"Cannot add policy: option \"{option}\" requires masking a distribution "
"policy, but no distribution policy named \"{name}\" exists."
msgstr ""
"პოლიტიკის დამატება შეუძლებელია: პარამეტრი \"{option}\" ითხოვს განაწილების "
"პოლიტიკის შენიღბვას, მაგრამ განაწილების პოლიტიკა სახელით \"{name}\" არ "
"არსებობს."

#: addvendorpolicy.cpp:172
msgid ""
"Cannot add policy: option \"{option}\" requires replacing an existing system "
"policy, but no system policy file named \"{name}\" exists."
msgstr ""
"პოლიტიკის დამატება შეუძლებელია: პარამეტრი \"{option}\" ითხოვს არსებული "
"სისტემური პოლიტიკის ჩანაცვლებას, მაგრამ სისტემური პოლიტიკის ფაილი სახელით \""
"{name}\" არ არსებობს."

#: addvendorpolicy.cpp:191 addvendorpolicy.cpp:215 addvendorpolicy.cpp:244
msgid "Replaced vendor policy file: {path}"
msgstr "ჩანაცვლდა მომწოდებლის პოლიტიკის ფაილი: {path}"

#: addvendorpolicy.cpp:196
msgid "Created vendor policy file: {path}"
msgstr "შეიქმნა მომწოდებლის პოლიტიკის ფაილი: {path}"

#: addvendorpolicy.cpp:204
msgid "Source file does not exist: {path}"
msgstr "წყარო ფაილი არ არსებობს: {path}"

#: addvendorpolicy.cpp:222 addvendorpolicy.cpp:251
msgid "Saved vendor policy file: {path}"
msgstr "შენახულია მომწოდებლის პოლიტიკის ფაილი: {path}"

#: addvendorpolicy.cpp:260
msgid "Masked distribution policy file: {path}"
msgstr "შენიღბულია განაწილების პოლიტიკის ფაილი: {path}"

#: addvendorpolicy.cpp:264
msgid "Failed to add vendor policy"
msgstr "მომწოდებლის პოლიტიკის დამატება ჩავარდა"

#: config-manager.cpp:47
msgid "Manage configuration"
msgstr "კონფიგურაციის მართვა"

#: listvendorpolicies.cpp:27
msgid "List vendor change policy files"
msgstr "მომწოდებლის ცვლილების პოლიტიკის ფაილების სია"

#: listvendorpolicies.cpp:33 removevendorpolicy.cpp:29
msgid "Policy base filename pattern (supports globs)"
msgstr "პოლიტიკის საბაზისო ფაილის სახელის ნიმუში (აქვს გლობების მხარდაჭერა)"

#: listvendorpolicies.cpp:42
msgid "Show detailed information about the policies"
msgstr "დეტალური ინფორმაციის ჩვენება პოლიტიკების შესახებ"

#: listvendorpolicies.cpp:61 removevendorpolicy.cpp:49
msgid "No vendor policy files found"
msgstr "მომწოდებლის პოლიტიკის ფაილები აღმოჩენილი არაა"

#: listvendorpolicies.cpp:80 removevendorpolicy.cpp:63
msgid "No matching vendor policy files found for pattern: {pattern}"
msgstr ""
"შესაბამისი მომწოდებლის პოლიტიკის ფაილები აღმოჩენილი არაა ნიმუშისთვის: "
"{pattern}"

#. Note for translators: This is a right-aligned column separator in
#. a package properties table as in "Name    : bash".
#: listvendorpolicies.cpp:149
msgid " : "
msgstr " : "

#. Add policy info
#: listvendorpolicies.cpp:155
msgid "Policy"
msgstr "პოლიტიკა"

#: listvendorpolicies.cpp:156
msgid "Source"
msgstr "წყარო"

#: listvendorpolicies.cpp:157
msgid "Distribution (read-only)"
msgstr "დისტრიბუტივი (მხოლოდ-წაკითხვადი)"

#: listvendorpolicies.cpp:157
msgid "System (manageable)"
msgstr "სისტემა (მართვადი)"

#: listvendorpolicies.cpp:157
msgid "Type"
msgstr "ტიპი"

#: listvendorpolicies.cpp:160
msgid "Masks"
msgstr "ნიღბები"

#: listvendorpolicies.cpp:165
msgid "Masked by"
msgstr "შენიღბვის ავტორი"

#: listvendorpolicies.cpp:174
msgid "<conversion failed: {what}>"
msgstr "<გადაყვანა ჩავარდა: {what}>"

#: listvendorpolicies.cpp:178 listvendorpolicies.cpp:183
msgid "Compact"
msgstr "კომპაქტური"

#: removevendorpolicy.cpp:23
msgid "Remove vendor change policy files"
msgstr "მომწოდებლის ცვლილების პოლიტიკის ფაილების წაშლა"

#: removevendorpolicy.cpp:74
msgid "Removed vendor policy file: {path}"
msgstr "წაიშალა მომწოდებლის პოლიტიკის ფაილი: {path}"

#: removevendorpolicy.cpp:78
msgid "Unmasked distribution policy file: {path}"
msgstr "შეუნიღბავი განაწილების პოლიტიკის ფაილი: {path}"

#: removevendorpolicy.cpp:83
msgid "Failed to remove policy file: {path}"
msgstr "პოლიტიკის ფაილის წაშლა ჩავარდა: {path}"

#: removevendorpolicy.cpp:87
msgid ""
"Cannot remove distribution policy file \"{path}\". To mask it, use: {command}"
msgstr ""
"განაწილების პოლიტიკის ფაილის \"{path}\" წაშლა შეუძლებელია. მის შესანიღბად "
"გამოიყენეთ {command}"

#: repos.cpp:56 setopt.cpp:140
#, c++-format
msgid "No matching repository to modify: {}"
msgstr "შესაცვლელად შესაბამისი რეპოზიტორია ვერ ვიპოვე: {}"

#: repos.hpp:42
msgid "Enables repositories"
msgstr "ჩართავს რეპოზიტორიებს"

#: repos.hpp:50
msgid "Disables repositories"
msgstr "გამორთავს რეპოზიტორიებს"

#: setopt.cpp:61 unsetopt.cpp:73
#, c++-format
msgid ""
"{}: Badly formatted argument value: Last key character cannot be '.': {}"
msgstr ""
"{}: ცუდად დაფორმატებული არგუმენტის მნიშვნელობა: ბოლო საკვანძო სიმბოლო ვერ "
"იქნება '.': {}"

#: setopt.cpp:70 unsetopt.cpp:82
#, c++-format
msgid "{}: Empty repository id is not allowed: {}"
msgstr "{}: ცარიელი რეპოზიტორიის id დაშვებული არაა: {}"

#: setopt.cpp:79
#, c++-format
msgid "Cannot set repository option \"{}\": {}"
msgstr "ვერ დავაყენე რეპოზიტორიის პარამეტრი \"{}\": {}"

#: setopt.cpp:86 setopt.cpp:149
#, c++-format
msgid ""
"Sets the \"{}\" option of the repository \"{}\" again with a different "
"value: \"{}\" != \"{}\""
msgstr ""
"დააყენებს პარამეტრს \"{}\" რეპოზიტორიისთვის \"{}\" კიდევ ერთხელ სხვა "
"მნიშვნელობით: \"{}\" != \"{}\""

#: setopt.cpp:100
#, c++-format
msgid "Cannot set option: \"{}\": {}"
msgstr "ვერ დავაყენე პარამეტრი: \"{}\": {}"

#: setvar.cpp:60
#, c++-format
msgid "Cannot set \"{}\": Variable \"{}\" is read-only"
msgstr "\"{}\"-ის დაყენება შეუძლებელია. ცვლადი \"{}\" მხოლოდ წაკითხვადია"

#: setvar.cpp:68
#, c++-format
msgid "Sets the \"{}\" variable again with a different value: \"{}\" != \"{}\""
msgstr ""
"დააყენებს ცვლადს \"{}\" კიდევ ერთხელ სხვა მნიშვნელობით: \"{}\" != \"{}\""

#: setvar.cpp:97 unsetvar.cpp:63
msgid "Missing path to vars directory"
msgstr "აკლია ბილიკი ცვლადების საქაღალდემდე"

#: setvar.cpp:110
#, c++-format
msgid "Cannot write variable to file \"{}\": {}"
msgstr "ვერ ჩავწერე ცვლადი ფაილში \"{}\": {}"

#: shared.hpp:65
#, c++-format
msgid ""
"The path \"{}\" exists, but it is not a directory or a symlink to a "
"directory."
msgstr ""
"ბილიკი \"{}\" არსებობს, მაგრამ ის არც საქაღალდეა, არც საქაღალდის სიმბმული."

#: shared.hpp:70
#, c++-format
msgid "The path \"{}\" exists, but it is a symlink to a non-existent object."
msgstr "ბილიკი \"{}\" არსებობს, მაგრამ ის სიმბმულია არრსებულ ობიექტზე."

#: shared.hpp:76
#, c++-format
msgid ""
"Directory \"{}\" does not exist. Add \"--create-missing-dir\" to create "
"missing directories."
msgstr ""
"საქაღალდე \"{}\" არ არსებობს. ნაკლული საქაღალდეების შესაქმნელად დაამატეთ \"--"
"create-missing-dir\"."

#: shared.hpp:87
#, c++-format
msgid "Variable name can contain only ASCII letters, numbers and '_': {}"
msgstr ""
"ცვლადის სახელი მხოლოდ ლათინურ სიმბოლოებს, ციფრებს და '_'-ს შეიძლება "
"შეიცავდეს: {}"

#: unsetopt.cpp:94
#, c++-format
msgid "config-manager: Request to remove unsupported repository option: {}"
msgstr ""
"config-manager: მოთხოვნა, წავშალო მხარდაუჭერელი რეპოზიტორიის პარამეტრი: {}"

#: unsetopt.cpp:106
#, c++-format
msgid "config-manager: Request to remove unsupported main option: {}"
msgstr "config-manager: მოთხოვნა, წავშალო მხარდაუჭერელი მთავარი პარამეტრი: {}"

#: unsetopt.cpp:140
#, c++-format
msgid ""
"config-manager: Request to remove main option but it is not present in the "
"config file: {}"
msgstr ""
"config-manager: მოთხოვნა, რომ წავშალო მთავარი პარამეტრი, მაგრამ ის "
"კონფიგურაციის ფაილში არ არსებობს: {}"

#: unsetopt.cpp:152
#, c++-format
msgid ""
"config-manager: Request to remove main option but config file not found: {}"
msgstr ""
"config-manager: მოთხოვნა, წავშალო მთავარი პარამეტრი, მაგრამ კონფიგურაციის "
"ფაილი ვერ ვიპოვე: {}"

#: unsetopt.cpp:186
#, c++-format
msgid ""
"config-manager: Request to remove repository option but repoid is not "
"present in the overrides: {}"
