#: addrepo.cpp:136
#, c++-format
msgid "from-repofile: \"{}\" file does not exist"
msgstr "from-repofile: „{}“ Datei existiert nicht"

#: addrepo.cpp:139
#, c++-format
msgid "from-repofile: {}"
msgstr "from-repofile: {}"

#: addrepo.cpp:169 setopt.cpp:53 setvar.cpp:49
#, c++-format
msgid "{}: Badly formatted argument value \"{}\""
msgstr "{}: Fehlerhaft formatierter Argumentwert „{}“"

#: addrepo.cpp:179
#, c++-format
msgid "Cannot set repository option \"{}={}\": {}"
msgstr "Paketquellen-Option „{}={}“ kann nicht gesetzt werden: {}"

#: addrepo.cpp:187 setopt.cpp:108
#, c++-format
msgid "Sets the \"{}\" option again with a different value: \"{}\" != \"{}\""
msgstr "Setzt die „{}“-Option wieder auf einen anderen Wert: „{}“ != „{}“"

#: addrepo.cpp:253
msgid "Missing path to repository configuration directory"
msgstr "Fehlender Pfad zum Paketquellen-Konfigurationsverzeichnis"

#: addrepo.cpp:303
#, c++-format
msgid "Failed to copy repository configuration file \"{}\": {}"
msgstr "Kopieren der Paketquellen-Konfigurationsdatei „{}“ fehlgeschlagen: {}"

#: addrepo.cpp:314
#, c++-format
msgid "Failed to download repository configuration file \"{}\": {}"
msgstr ""
"Herunterladen der Paketquellen-Konfigurationsdatei „{}“ fehlgeschlagen: {}"

#: addrepo.cpp:342
#, c++-format
msgid ""
"Error in added repository configuration file. Cannot set repository option "
"\"{}={}\": {}"
msgstr ""
"Fehler in der hinzugefügten Paketquellen-Konfigurationsdatei. Paketquellen-"
"Option „{}={}“ kann nicht gesetzt werden: {}"

#: addrepo.cpp:376
#, c++-format
msgid "Bad baseurl: {}={}"
msgstr "Ungültige Basis-URL: {}={}"

#: addrepo.cpp:384
msgid ""
"One of --from-repofile=<URL>, --set=baseurl=<URL>, --set=mirrorlist=<URL>, --"
"set=metalink=<URL> must be set to a non-empty URL"
msgstr ""
"Eines von --from-repofile=<URL>, --set=baseurl=<URL>, --"
"set=mirrorlist=<URL>, --set=metalink=<URL> muss auf eine nicht-leere URL "
"gesetzt werden"

#: addrepo.cpp:429
#, c++-format
msgid "Failed to save repository configuration file \"{}\": {}"
msgstr "Speichern der Paketquellen-Konfigurationsdatei „{}“ fehlgeschlagen: {}"

#: addrepo.cpp:451
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--add-or-replace\" or \"--overwrite\"."
msgstr ""
"Datei „{}“ existiert bereits und konfiguriert Paketquellen mit IDs „{}“. "
"Fügen Sie „--add-or-replace“ oder „--overwrite“ hinzu."

#: addrepo.cpp:454
#, c++-format
msgid ""
"File \"{}\" already exists and configures repositories with IDs \"{}\". Add "
"\"--overwrite\" to overwrite."
msgstr ""
"Datei „{}“ existiert bereits und konfiguriert Paketquellen mit IDs „{}“. "
"Fügen Sie „--overwrite“ zum Überschreiben hinzu."

#: addrepo.cpp:474 addrepo.cpp:500
#, c++-format
msgid "A repository with id \"{}\" already configured in file: {}"
msgstr "Eine Paketquelle mit ID „{}“ ist bereits konfiguriert in Datei: {}"

#: addrepo.cpp:486 shared.hpp:150
#, c++-format
msgid "Cannot read repositories from directory \"{}\": {}"
msgstr "Paketquellen können nicht aus dem Verzeichnis „{}“ gelesen werden: {}"

#: config-manager.cpp:44
msgid "Manage configuration"
msgstr "Konfiguration verwalten"

#: repos.cpp:56 setopt.cpp:140
#, c++-format
msgid "No matching repository to modify: {}"
msgstr "Keine passende Paketquelle zum Ändern gefunden: {}"

#: repos.hpp:42
msgid "Enables repositories"
msgstr ""

#: repos.hpp:50
msgid "Disables repositories"
msgstr ""

#: setopt.cpp:61 unsetopt.cpp:73
#, c++-format
msgid ""
"{}: Badly formatted argument value: Last key character cannot be '.': {}"
msgstr ""
"{}: Fehlerhaft formatierter Argumentwert: Letzter Schlüsselwert darf nicht "
"„.“ sein: {}"

#: setopt.cpp:70 unsetopt.cpp:82
#, c++-format
msgid "{}: Empty repository id is not allowed: {}"
msgstr "{}: Leere Paketquellen-ID ist nicht erlaubt: {}"

#: setopt.cpp:79
#, c++-format
msgid "Cannot set repository option \"{}\": {}"
msgstr "Paketquellen-Option „{}“ kann nicht gesetzt werden: {}"

#: setopt.cpp:86 setopt.cpp:149
#, c++-format
msgid ""
"Sets the \"{}\" option of the repository \"{}\" again with a different "
"value: \"{}\" != \"{}\""
msgstr ""
"Setzt die „{}“-Option der Paketquelle „{}“ mit einem anderen Wert erneut: "
"„{}“ != „{}“"

#: setopt.cpp:100
#, c++-format
msgid "Cannot set option: \"{}\": {}"
msgstr "Option kann nicht gesetzt werden: \"{}\": {}"

#: setvar.cpp:60
#, c++-format
msgid "Cannot set \"{}\": Variable \"{}\" is read-only"
msgstr "„{}“ kann nicht gesetzt werden: Variable „{}“ ist schreibgeschützt"

#: setvar.cpp:68
#, c++-format
msgid "Sets the \"{}\" variable again with a different value: \"{}\" != \"{}\""
msgstr "Setzt die Variable „{}“ mit einem anderen Wert erneut: „{}“ != „{}“"

#: setvar.cpp:97 unsetvar.cpp:63
msgid "Missing path to vars directory"
msgstr "Fehlender Pfad zum Variablenverzeichnis"

#: setvar.cpp:110
#, c++-format
msgid "Cannot write variable to file \"{}\": {}"
msgstr "Variable kann nicht in Datei „{}“ geschrieben werden: {}"

#: shared.hpp:59
#, c++-format
msgid ""
"The path \"{}\" exists, but it is not a directory or a symlink to a "
"directory."
msgstr ""
"Der Pfad „{}“ existiert, ist aber kein Verzeichnis oder symbolischer Link zu "
"einem Verzeichnis."

#: shared.hpp:64
#, c++-format
msgid "The path \"{}\" exists, but it is a symlink to a non-existent object."
msgstr ""
"Der Pfad „{}“ existiert, ist aber ein symbolischer Link zu einem nicht "
"existierenden Objekt."

#: shared.hpp:70
#, c++-format
msgid ""
"Directory \"{}\" does not exist. Add \"--create-missing-dir\" to create "
"missing directories."
msgstr ""
"Verzeichnis „{}“ existiert nicht. Fügen Sie „--create-missing-dir“ hinzu, um "
"fehlende Verzeichnisse anzulegen."

#: shared.hpp:81
#, c++-format
msgid "Variable name can contain only ASCII letters, numbers and '_': {}"
msgstr "Variablenname darf nur ASCII-Zeichen, Zahlen und '_' enthalten: {}"

#: unsetopt.cpp:94
#, c++-format
msgid "config-manager: Request to remove unsupported repository option: {}"
msgstr ""
"config-manager: Anforderung zur Entfernung einer nicht unterstützten "
"Paketquellen-Option: {}"

#: unsetopt.cpp:106
#, c++-format
msgid "config-manager: Request to remove unsupported main option: {}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer nicht unterstützten "
"Hauptoption: {}"

#: unsetopt.cpp:140
#, c++-format
msgid ""
"config-manager: Request to remove main option but it is not present in the "
"config file: {}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer Hauptoption, welche nicht in "
"der Konfigurationsdatei enthalten ist: {}"

#: unsetopt.cpp:152
#, c++-format
msgid ""
"config-manager: Request to remove main option but config file not found: {}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer Hauptoption, aber die "
"Konfigurationsdatei wurde nicht gefunden: {}"

#: unsetopt.cpp:186
#, c++-format
msgid ""
"config-manager: Request to remove repository option but repoid is not "
"present in the overrides: {}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer Paketquellen-Option, deren "
"Paketquellen-ID nicht in den Überschreibungen vorhanden ist: {}"

#: unsetopt.cpp:194
#, fuzzy, c++-format
#| msgid ""
#| "config-manager: Request to remove repository option but it is not present "
#| "in the overrides: {}.{}"
msgid ""
"config-manager: Request to remove repository option but it is not present in "
"the overrides: {}.{}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer Paketquellen-Option, die nicht "
"in den Überschreibungen vorhanden ist: {}"

#: unsetopt.cpp:208
#, c++-format
msgid ""
"config-manager: Request to remove repository option but file with overrides "
"not found: {}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer Paketquellen-Option, aber die "
"Datei mit Überschreibungen wurde nicht gefunden: {}"

#: unsetvar.cpp:69
#, c++-format
msgid ""
"config-manager: Request to remove variable but vars directory was not found: "
"{}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer Variable, aber das "
"Variablenverzeichnis wurde nicht gefunden: {}"

#: unsetvar.cpp:82
#, c++-format
msgid ""
"config-manager: Request to remove variable but it is not present in the vars "
"directory: {}"
msgstr ""
"config-manager: Anfrage zur Entfernung einer Variable, aber sie ist nicht im "
"Variablenverzeichnis vorhanden: {}"

#: unsetvar.cpp:88
#, c++-format
msgid "Cannot remove variable file \"{}\": {}"
msgstr "Variablendatei „{}“ kann nicht entfernt werden:{}"
