#: reposync.cpp:67
msgid "Synchronize a remote DNF repository to a local directory."
msgstr "დაშორებული DNF-ის რეპოზიტორიის სინქრონიზაცია ლოკალურ საქაღალდეში."

#: reposync.cpp:122
#, c++-format
msgid ""
"Invalid value \"{}\" for \"--latest-limit\", a positive integer is required"
msgstr ""
"არასწორი მნიშვნელობა \"{}\" პარამეტრისთვის \"--latest-limit\". საჭიროა "
"დადებითი მთელი რიცხვი"

#: reposync.cpp:191
msgid "Can't use --norepopath with multiple repositories enabled"
msgstr ""
"როცა ერთზე მეტი რეპოზიტორია ჩართულია, პარამეტრს --norepopath ვერ გამოიყენებთ"

#: reposync.cpp:196
msgid "Can't use --safe-write-path with multiple repositories enabled"
msgstr ""
"როცა ერთზე მეტი რეპოზიტორიაა ჩართული, პარამეტრს --safe-write ვერ გამოიყენებთ"

#: reposync.cpp:292
#, c++-format
msgid ""
"Download destination '{0}' for location '{1}' of '{2}' package from '{3}' "
"repo is outside of safe write path '{4}'."
msgstr ""
"გადმოწერის სამიზნე '{0}' მდებარეობისთვის '{1}' '{2}' პაკეტი '{3} "
"რეპოზიტორიიდან უსაფრთხო ჩაწერის ბილიკის '{4}' გარეთაა."

#: reposync.cpp:320
#, c++-format
msgid "Failed to download package: {}"
msgstr "გადმოწერის შეცდომა პაკეტისთვის: {}"

#: reposync.cpp:323
msgid "Failed to download one or more packages"
msgstr "ერთი ან მეტი პაკეტის გადმოწერის შეცდომა"

#: reposync.cpp:335
#, c++-format
msgid "Failed to create directory '{0}' iterator: {1}"
msgstr "საქაღალდის '{0}' იტერატორის შექმნა ჩავარდა: {1}"

#: reposync.cpp:348
#, c++-format
msgid "Failed to delete file {0}: {1}"
msgstr "ფაილის '{0}' წაშლა ჩავარდა: {1}"

#: reposync.cpp:351
#, c++-format
msgid "[DELETED] {}"
msgstr "[წაიშალა] {}"

#: reposync.cpp:367
#, c++-format
msgid "Removing '{}' with failing OpenPGP check: {}"
msgstr "'{}'-ის წაშლა ჩავარდნილი OpenPGP-ის შემოწმებით: {}"

#: reposync.cpp:430
msgid "Failed to get mirror for metadata."
msgstr "მეტამონაცემებისთვის სარკის მიღება ჩავარდა."

#: reposync.cpp:440
#, c++-format
msgid "Failed to get mirror for package: \"{}\""
msgstr "სარკის მიღება ჩავარდა პაკეტისთვის: \"{}\""

#: reposync.cpp:456
msgid "OpenPGP signature check failed"
msgstr "OpenPGP-ის ხელმოწერის შემოწმება ჩავარდა"
