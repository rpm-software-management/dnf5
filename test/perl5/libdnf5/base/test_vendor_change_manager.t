# Test: work_with_files
{
    my ($base, $distrib_vendor_cfg_dir, $system_vendor_cfg_dir) = setup_test_base();

    # Create TOML files
    my $distr_allow_cmdline = "$distrib_vendor_cfg_dir/allow_cmdline.conf";
    my $distr_allow_fedora = "$distrib_vendor_cfg_dir/allow_fedora.conf";
    my $allow_fedora = "$system_vendor_cfg_dir/allow_fedora.conf";
    my $test1 = "$system_vendor_cfg_dir/test1.conf";

    write_file($distr_allow_cmdline, $POLICY_TOML_ALLOW_CMDLINE);
    write_file($distr_allow_fedora, $POLICY_TOML_ALLOW_FEDORA);
    write_file($test1, $POLICY_TOML_TEST_1);
    write_file($allow_fedora, $POLICY_TOML_TEST_2);

    $base->setup();
    my $vcm = $base->get_vendor_change_manager();

    my $files = $vcm->get_policy_files();
    # SWIG custom typemap converts vector<path> to array of strings in Perl
    my @files = @$files;

    # allow_fedora overrides (masks) distr_allow_fedora -> only 3 files loaded
    is(scalar(@files), 3, "Got 3 policy files");
    is($files[0], $distr_allow_cmdline, "File 0 is distr_allow_cmdline");
    is($files[1], $allow_fedora, "File 1 is allow_fedora");
    is($files[2], $test1, "File 2 is test1");

    # Only configuration files in system_vendor_cfg_dir are manageable
    ok(!$vcm->is_policy_file_manageable($distr_allow_cmdline), "distr_allow_cmdline is not manageable");
    ok(!$vcm->is_policy_file_manageable($distr_allow_fedora), "distr_allow_fedora is not manageable");
    ok($vcm->is_policy_file_manageable($allow_fedora), "allow_fedora is manageable");
    ok($vcm->is_policy_file_manageable($test1), "test1 is manageable");

    # allow_fedora overrides (masks) distr_allow_fedora
    is($vcm->get_masked_policy_file($distr_allow_cmdline), "", "distr_allow_cmdline masks nothing");
    is($vcm->get_masked_policy_file($distr_allow_fedora), "", "distr_allow_fedora masks nothing");
    is($vcm->get_masked_policy_file($allow_fedora), $distr_allow_fedora, "allow_fedora masks distr_allow_fedora");
    is($vcm->get_masked_policy_file($test1), "", "test1 masks nothing");

    # Test find_policy_file
    is($vcm->find_policy_file("allow_cmdline"), $distr_allow_cmdline, "find_policy_file(allow_cmdline)");
    is($vcm->find_policy_file("allow_fedora"), $allow_fedora, "find_policy_file(allow_fedora)");
    is($vcm->find_policy_file("test1"), $test1, "find_policy_file(test1)");
    is($vcm->find_policy_file("non_exist"), "", "find_policy_file(non_exist) returns empty");

    # Test remove_policy_file
    throws_ok {
        $vcm->remove_policy_file($distr_allow_cmdline);
    } qr//, "remove_policy_file throws on distribution file";

    $vcm->remove_policy_file("allow_fedora");
    $vcm->remove_policy_file("test1");

    $files = $vcm->get_policy_files();
    @files = @$files;
    is(scalar(@files), 2, "After removal, got 2 policy files");
    is($files[0], $distr_allow_cmdline, "File 0 is distr_allow_cmdline");
    is($files[1], $distr_allow_fedora, "File 1 is distr_allow_fedora");

    # Test save_policy_from_compact
    $vcm->save_policy_from_compact($POLICY_COMPACT_TEST_2, "test:code", "allow_fedora");
    is(read_file($allow_fedora), $POLICY_TOML_TEST_2, "save_policy_from_compact wrote correct content");

    # fail - file already exists
    throws_ok {
        $vcm->save_policy_from_compact($POLICY_COMPACT_TEST_2, "test:code", "allow_fedora");
    } qr//, "save_policy_from_compact throws on existing file";

    # Test save_policy_from_toml with TOML content string
    $vcm->save_policy_from_toml($POLICY_TOML_TEST_1, "test:code", "test1");
    is(read_file($test1), $POLICY_TOML_TEST_1, "save_policy_from_toml(content) wrote correct content");

    # Test save_policy_from_toml with TOML file
    my $installroot = $base->get_config()->get_installroot_option()->get_value();
    make_path("$installroot/tmp");
    my $path = "$installroot/tmp/toml_test1.conf";
    write_file($path, $POLICY_TOML_TEST_1);

    $vcm->save_policy_from_toml($path, "from_toml_file");
    my $from_toml_file = "$system_vendor_cfg_dir/from_toml_file.conf";
    is(read_file($from_toml_file), $POLICY_TOML_TEST_1, "save_policy_from_toml(path) wrote correct content");

    $files = $vcm->get_policy_files();
    @files = @$files;
    is(scalar(@files), 4, "After saves, got 4 policy files");
    is($files[0], $distr_allow_cmdline, "File 0 is distr_allow_cmdline");
    is($files[1], $allow_fedora, "File 1 is allow_fedora");
    is($files[2], $from_toml_file, "File 2 is from_toml_file");
    is($files[3], $test1, "File 3 is test1");
}

done_testing();
