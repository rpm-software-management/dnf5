# Test: load_policy_from_toml_file
{
    my ($base) = setup_test_base();
    $base->setup();
    my $vcm = $base->get_vendor_change_manager();

    my $installroot = $base->get_config()->get_installroot_option()->get_value();
    my $path = "$installroot/tmp/vendor_policy.conf";

    write_file($path, $POLICY_TOML_TEST_1);

    $vcm->load_policy_from_toml($path);

    is($vcm->get_loaded_policies_count(), 1, "Loaded 1 policy from TOML file");
    my $source = $vcm->get_loaded_policy_source(0);
    is($source, "file://" . $path, "Policy source is file URI");
    is($vcm->get_loaded_policy_as_compact(0), $POLICY_COMPACT_TEST_1, "Policy as compact matches");
    is($vcm->get_loaded_policy_as_toml(0), $POLICY_TOML_TEST_1, "Policy as TOML matches");
}

# Test: convert_toml_to_compact
{
    my $compact = libdnf5::base::VendorChangeManager::convert_policy_toml_to_compact(
        $POLICY_TOML_ALLOW_CMDLINE, "text:test");
    is($compact, $POLICY_COMPACT_ALLOW_CMDLINE, "TOML to compact conversion (allow_cmdline)");

    $compact = libdnf5::base::VendorChangeManager::convert_policy_toml_to_compact(
        $POLICY_TOML_ALLOW_FEDORA, "text:test");
    is($compact, $POLICY_COMPACT_ALLOW_FEDORA, "TOML to compact conversion (allow_fedora)");

    $compact = libdnf5::base::VendorChangeManager::convert_policy_toml_to_compact(
        $POLICY_TOML_TEST_1, "text:test");
    is($compact, $POLICY_COMPACT_TEST_1, "TOML to compact conversion (test_1)");

    $compact = libdnf5::base::VendorChangeManager::convert_policy_toml_to_compact(
        $POLICY_TOML_TEST_2, "text:test");
    is($compact, $POLICY_COMPACT_TEST_2, "TOML to compact conversion (test_2)");
}

