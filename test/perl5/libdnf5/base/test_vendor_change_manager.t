# Test: convert_compact_to_toml
{
    my $toml = libdnf5::base::VendorChangeManager::convert_policy_compact_to_toml(
        $POLICY_COMPACT_ALLOW_CMDLINE, "text:test");
    is($toml, $POLICY_TOML_ALLOW_CMDLINE, "Compact to TOML conversion (allow_cmdline)");

    $toml = libdnf5::base::VendorChangeManager::convert_policy_compact_to_toml(
        $POLICY_COMPACT_ALLOW_FEDORA, "text:test");
    is($toml, $POLICY_TOML_ALLOW_FEDORA, "Compact to TOML conversion (allow_fedora)");

    $toml = libdnf5::base::VendorChangeManager::convert_policy_compact_to_toml(
        $POLICY_COMPACT_TEST_1, "text:test");
    is($toml, $POLICY_TOML_TEST_1, "Compact to TOML conversion (test_1)");

    $toml = libdnf5::base::VendorChangeManager::convert_policy_compact_to_toml(
        $POLICY_COMPACT_TEST_2, "text:test");
    is($toml, $POLICY_TOML_TEST_2, "Compact to TOML conversion (test_2)");
}

# Test: unload_policies
{
    my ($base) = setup_test_base();
    $base->setup();
    my $vcm = $base->get_vendor_change_manager();

    $vcm->load_policy_from_compact('eq:"V1", in:"V2"', "text:test1");
    $vcm->load_policy_from_compact('out:"V5", eq:"V4"', "text:test2");
    is($vcm->get_loaded_policies_count(), 2, "Loaded 2 policies");

    my $unloaded_count = $vcm->unload_policies();
    is($unloaded_count, 2, "Unloaded 2 policies");
    is($vcm->get_loaded_policies_count(), 0, "All policies unloaded");
}

# Test: unload_policy
{
    my ($base) = setup_test_base();
    $base->setup();
    my $vcm = $base->get_vendor_change_manager();

    $vcm->load_policy_from_compact('in:"V0"', "text:source0");
    $vcm->load_policy_from_compact('in:"V1"', "text:source1");
    $vcm->load_policy_from_compact('in:"V2"', "text:source2");
    $vcm->load_policy_from_compact('in:"V3"', "text:source3");
    $vcm->load_policy_from_compact('in:"V4"', "text:source4");
    $vcm->load_policy_from_compact('in:"V5"', "text:source5");
    is($vcm->get_loaded_policies_count(), 6, "Loaded 6 policies");

    $vcm->unload_policy(2);
    is($vcm->get_loaded_policies_count(), 5, "Unloaded policy at index 2");
    is($vcm->get_loaded_policy_source(2), "text:source3", "Policy at index 2 is now source3");

    $vcm->unload_policy(4);
    is($vcm->get_loaded_policies_count(), 4, "Unloaded policy at index 4");
    is($vcm->get_loaded_policy_source(3), "text:source4", "Policy at index 3 is now source4");

    $vcm->unload_policy(0);
    is($vcm->get_loaded_policies_count(), 3, "Unloaded policy at index 0");
    is($vcm->get_loaded_policy_source(0), "text:source1", "Policy at index 0 is now source1");
    is($vcm->get_loaded_policy_source(2), "text:source4", "Policy at index 2 is now source4");

    eval { $vcm->unload_policy(999); };
    ok($@, "Unload policy with invalid index throws error");
}

# Test: unload_policies_matching_source
{
    my ($base) = setup_test_base();
    $base->setup();
    my $vcm = $base->get_vendor_change_manager();

    $vcm->load_policy_from_compact('in:"V1"', "text:source1");
    $vcm->load_policy_from_compact('in:"V2"', "text:source2");
    $vcm->load_policy_from_compact('in:"NV2"', "text:new_source2");
    $vcm->load_policy_from_compact('in:"V3"', "text:source3");
    $vcm->load_policy_from_compact('in:"V4"', "text:source4");
    $vcm->load_policy_from_compact('in:"NV3"', "text:source3");
    is($vcm->get_loaded_policies_count(), 6, "Loaded 6 policies");

    my $unloaded_count = $vcm->unload_policies_matching_source("text:source3");
    is($unloaded_count, 2, "Unloaded 2 policies matching 'text:source3'");
    is($vcm->get_loaded_policies_count(), 4, "4 policies remaining");

    $unloaded_count = $vcm->unload_policies_matching_source("te?t:*source2");
    is($unloaded_count, 2, "Unloaded 2 policies matching 'te?t:*source2'");
    is($vcm->get_loaded_policies_count(), 2, "2 policies remaining");
}

