my $POLICY_COMPACT_ALLOW_CMDLINE = '@in:[cmdline_repo="1"]';

my $POLICY_TOML_ALLOW_CMDLINE = <<'EOF';
version = '1.2'

[[incoming_packages]]
filters = [
  { filter = 'cmdline_repo', value = "1" }
]
EOF

my $POLICY_COMPACT_ALLOW_FEDORA = 'in:"Fedora Project"';

my $POLICY_TOML_ALLOW_FEDORA = <<'EOF';
version = '1.2'

[[incoming_vendors]]
vendor = "Fedora Project"
EOF

my $POLICY_COMPACT_TEST_1 = 'in:ei*" test ",eq:^"MyVendor ",out:"OldVendor"';

my $POLICY_TOML_TEST_1 = <<'EOF';
version = '1.2'

[[incoming_vendors]]
vendor = " test "
comparator = 'ICONTAINS'
exclude = true

[[equivalent_vendors]]
vendor = "MyVendor "
comparator = 'STARTSWITH'

[[outgoing_vendors]]
vendor = "OldVendor"
EOF

my $POLICY_COMPACT_TEST_2 = 'in:"My Vendor"@in:[source_name="mypackage",version>="2.0"]';

my $POLICY_TOML_TEST_2 = <<'EOF';
version = '1.2'

[[incoming_vendors]]
vendor = "My Vendor"

[[incoming_packages]]
filters = [
  { filter = 'source_name', value = "mypackage" },
  { filter = 'version', value = "2.0", comparator = 'GTE' }
]
EOF


sub setup_test_base {
    my $base = new libdnf5::base::Base();
    my $temp_dir = tempdir(CLEANUP => 1, TEMPLATE => 'libdnf5_perl5_vendortest.XXXXXX');
    # Convert to absolute path
    $temp_dir = abs_path($temp_dir);

    # Set config paths (adresáře nemusí existovat před voláním set)
    $base->get_config()->get_installroot_option()->set("$temp_dir/installroot");
    $base->get_config()->get_cachedir_option()->set("$temp_dir/cache");

    # Get install prefix from test config (generated by CMake), fallback to /usr
    my $install_prefix = eval { $TestConfig::CMAKE_INSTALL_PREFIX } || "/usr";
    # Convert to relative path by removing leading /
    $install_prefix =~ s/^\///;  # Remove leading slash

    my $installroot = $base->get_config()->get_installroot_option()->get_value();

    # Create necessary directories for vendor configs
    make_path("$installroot/tmp");
    my $distrib_vendor_cfg_dir = "$installroot/$install_prefix/share/dnf5/vendors.d";
    my $system_vendor_cfg_dir = "$installroot/etc/dnf/vendors.d";
    make_path($distrib_vendor_cfg_dir);
    make_path($system_vendor_cfg_dir);

    return ($base, $distrib_vendor_cfg_dir, $system_vendor_cfg_dir);
}

sub write_file {
    my ($path, $content) = @_;
    open(my $fh, '>', $path) or die "Cannot open $path: $!";
    print $fh $content;
    close($fh);
}

sub read_file {
    my ($path) = @_;
    open(my $fh, '<', $path) or die "Cannot open $path: $!";
    local $/;
    my $content = <$fh>;
    close($fh);
    return $content;
}


# Test: load_policy_from_compact
{
    my ($base) = setup_test_base();
    $base->setup();
    my $vcm = $base->get_vendor_change_manager();

    $vcm->load_policy_from_compact($POLICY_COMPACT_TEST_1, "text:test");

    is($vcm->get_loaded_policies_count(), 1, "Loaded 1 policy from compact format");
    is($vcm->get_loaded_policy_source(0), "text:test", "Policy source is correct");
    is($vcm->get_loaded_policy_as_compact(0), $POLICY_COMPACT_TEST_1, "Policy as compact matches");
    is($vcm->get_loaded_policy_as_toml(0), $POLICY_TOML_TEST_1, "Policy as TOML matches");
}

